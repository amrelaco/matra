---
import '../styles/global.css'
interface Props {
  title: string
  description: string
  editable?: boolean
}
const { title, description, editable = true } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#111114" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {editable && (
      <div id="editable-banner" class="banner" hidden>
        <span class="mono">
          Every word on this page is editable. It is the product, not a screenshot.
        </span>
        <button type="button" aria-label="Dismiss">×</button>
      </div>
    )}
    <slot />
    {editable && <script>import '../scripts/editable.ts'</script>}

    <style>
      .banner {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 60;
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--invert-bg);
        color: var(--invert-fg);
        padding: 11px 14px 11px 18px;
        font-size: 12.5px;
        max-width: calc(100vw - 32px);
      }
      .banner button {
        background: none;
        border: none;
        color: var(--invert-soft);
        font-size: 17px;
        cursor: pointer;
        line-height: 1;
        padding: 0 4px;
      }
      .banner button:hover { color: var(--invert-fg); }
    </style>
  </body>
</html>
