---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
interface Props {
  title: string
  description: string
  editable?: boolean
}
const { title, description, editable = true } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f5f1e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      Client-side navigation. Moving between pages swaps the document instead of
      reloading it, so the fonts stay warm and the page does not flash white
      between one doc page and the next.
    -->
    <ClientRouter />

    <!--
      The stored theme, before the first paint.

      This has to be inline and blocking. A module runs after the document has
      been painted, which means a visitor who chose dark gets one light frame on
      every load — the flash that makes a theme toggle feel broken.
    -->
    <script is:inline>
      try {
        if (localStorage.getItem('matra-theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark'
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#111114')
        }
      } catch {
        /* Private mode blocks localStorage. Light is the default anyway. */
      }
    </script>
  </head>
  <body>
    <slot />

    <script>
      /**
       * Anything leaving the site opens in a new tab.
       *
       * Marked here rather than on each link: one rule cannot be forgotten,
       * and rel=noopener is not optional — a new tab gets a handle on this one
       * without it.
       */
      const markExternal = () => {
        for (const link of document.querySelectorAll('a[href^="http"]')) {
          if (link.host === window.location.host) continue
          link.setAttribute('target', '_blank')
          link.setAttribute('rel', 'noopener noreferrer')
        }
      }
      markExternal()
      document.addEventListener('astro:page-load', markExternal)
    </script>
    <!--
      The keyboard, one press away. Rendered on every page because every page
      is editable and none of it announces its keys.
    -->
    <button
      type="button"
      class="btn ghost keys-button"
      data-keys-toggle
      aria-expanded="false"
      aria-label="Keyboard shortcuts"></button>

    <script>
      import '../scripts/theme.ts'
    </script>
    <script>
      import '../scripts/shortcuts.ts'
    </script>
    {editable && <script>import '../scripts/editable.ts'</script>}
  </body>
</html>
