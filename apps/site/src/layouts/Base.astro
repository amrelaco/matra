---
import { ClientRouter } from 'astro:transitions'
import facts from '../data/facts.json'
import '../styles/global.css'
interface Props {
  title: string
  description: string
  editable?: boolean
  /** Set on pages that should stay out of the index — thanks pages, redirects. */
  noindex?: boolean
  /** Overrides the default social card. Absolute or root-relative. */
  image?: string
  /**
   * Extra structured data for this page, added to the site-wide graph.
   *
   * The graph below says what Matra *is*, and it is the same on every page —
   * which is right for the organisation and the software, and useless for
   * telling an answer engine what *this* page covers. A docs page passes a
   * `TechArticle` and its breadcrumbs; the comparison page passes its
   * questions as an `FAQPage`. Those are the shapes that get quoted back.
   */
  schema?: Record<string, unknown>[]
}
const {
  title,
  description,
  editable = true,
  noindex = false,
  image = '/og.png',
  schema = [],
} = Astro.props

/**
 * Canonical has to be absolute and has to be the *clean* URL.
 *
 * Astro.url carries whatever the request came in on, which on Vercel includes
 * the deployment host for preview builds. Resolving against Astro.site pins
 * every page to matrajs.com, so a preview deploy that gets crawled points its
 * canonical at production instead of competing with it.
 */
const canonical = new URL(Astro.url.pathname.replace(/\/{2,}/g, '/'), Astro.site).href
const social = new URL(image, Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Matra" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social} />

    <meta name="theme-color" content="#f5f1e8" />
    <!--
      Google will not show a favicon that is not square, and looks for
      /favicon.ico before anything declared here. The search result for
      "matrajs" showed the generic globe because the SVG was 64x74 and the ico
      did not exist. The SVG stays first for browsers, which prefer it and get
      a mark that follows the theme; the raster copies carry the paper ground
      baked in, because Google draws the icon on a chip of its own colour.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <!--
      Points crawlers that read it at the plain-text index of the docs. Harmless
      to the ones that do not.
    -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Matra docs for LLMs" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="Matra docs for LLMs, in full"
    />
    <!--
      Client-side navigation. Moving between pages swaps the document instead of
      reloading it, so the fonts stay warm and the page does not flash white
      between one doc page and the next.
    -->
    <ClientRouter />

    <!--
      The stored theme, before the first paint.

      This has to be inline and blocking. A module runs after the document has
      been painted, which means a visitor who chose dark gets one light frame on
      every load — the flash that makes a theme toggle feel broken.
    -->
    <script is:inline>
      try {
        if (localStorage.getItem('matra-theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark'
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#111114')
        }
      } catch {
        /* Private mode blocks localStorage. Light is the default anyway. */
      }
    </script>

    <!--
      Structured data. Search engines use it for rich results; the answer
      engines (ChatGPT, Perplexity, Gemini) lean on it harder, because it is
      the only part of the page that states what this thing *is* without
      needing prose parsed out of it.
    -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': 'https://matrajs.com/#website',
            url: 'https://matrajs.com/',
            name: 'Matra',
            // The project is Matra; the thing people type into Google is
            // "matrajs", which is the npm scope and the domain. Saying both
            // here is how the two get treated as one entity rather than as a
            // near-miss.
            alternateName: ['MatraJS', 'matrajs'],
            description:
              'A headless rich text editor framework with a first-class extension model.',
            publisher: { '@id': 'https://matrajs.com/#org' },
            inLanguage: 'en',
          },
          {
            '@type': 'Organization',
            '@id': 'https://matrajs.com/#org',
            name: 'Amrela',
            url: 'https://matrajs.com/',
            // A raster, not the SVG. Google's logo guidance wants an image it
            // can rasterise predictably, and the icon it was pointed at was
            // not even square until today.
            logo: 'https://matrajs.com/icon-512.png',
          },
          {
            '@type': 'SoftwareSourceCode',
            '@id': 'https://matrajs.com/#software',
            name: 'Matra',
            description:
              'A headless rich text editor framework for React, Vue, Svelte and Solid, with a first-class extension model, collaborative editing, version history and AI streaming edits.',
            url: 'https://matrajs.com/',
            codeRepository: 'https://github.com/amrelaco/matra',
            programmingLanguage: 'TypeScript',
            runtimePlatform: 'JavaScript',
            license: 'https://matrajs.com/licence',
            author: { '@id': 'https://matrajs.com/#org' },
          },
          {
            '@type': 'SoftwareApplication',
            '@id': 'https://matrajs.com/#app',
            name: 'Matra',
            applicationCategory: 'DeveloperApplication',
            operatingSystem: 'Web',
            url: 'https://matrajs.com/',
            softwareVersion: facts.version,
            offers: [
              {
                '@type': 'Offer',
                name: 'Core',
                price: '0',
                priceCurrency: 'USD',
                description: 'MIT-licensed core and framework bindings.',
              },
              {
                '@type': 'Offer',
                name: 'Pro',
                price: '99',
                priceCurrency: 'USD',
                description: 'Commercial licence for AI, collaboration and version history.',
              },
              {
                '@type': 'Offer',
                name: 'Business',
                price: '349',
                priceCurrency: 'USD',
                description: 'Commercial licence with a larger developer cap.',
              },
            ],
            author: { '@id': 'https://matrajs.com/#org' },
          },
          ...schema,
        ],
      })}
    />
  </head>
  <body>
    <slot />

    <script>
      /**
       * Anything leaving the site opens in a new tab.
       *
       * Marked here rather than on each link: one rule cannot be forgotten,
       * and rel=noopener is not optional — a new tab gets a handle on this one
       * without it.
       */
      const markExternal = () => {
        for (const link of document.querySelectorAll('a[href^="http"]')) {
          if (link.host === window.location.host) continue
          link.setAttribute('target', '_blank')
          link.setAttribute('rel', 'noopener noreferrer')
        }
      }
      markExternal()
      document.addEventListener('astro:page-load', markExternal)
    </script>
    <!--
      The keyboard, one press away. Rendered on every page because every page
      is editable and none of it announces its keys.
    -->
    <button
      type="button"
      class="btn ghost keys-button"
      data-keys-toggle
      aria-expanded="false"
      aria-label="Keyboard shortcuts"></button>

    <script>
      import '../scripts/theme'
    </script>
    <script>
      import '../scripts/tooltip'
    </script>
    <script>
      import '../scripts/shortcuts'
    </script>
    {editable && <script>import '../scripts/editable'</script>}
  </body>
</html>
