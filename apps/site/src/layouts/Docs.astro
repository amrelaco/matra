---
import { ArrowLeft02Icon, ArrowRight02Icon } from '@hugeicons/core-free-icons'
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'
import Nav from '../components/Nav.astro'
import api from '../data/extensions-api.json'
import Base from '../layouts/Base.astro'

interface Props {
  title: string
  description: string
  section: string
  heading: string
}
const { title, description, section, heading } = Astro.props

/**
 * Three columns, as in the design file: navigation, the article, and what is on
 * this page. The right-hand column is built from the rendered headings rather
 * than from a list written by hand, because a hand-written one drifts and then
 * points at a heading somebody renamed.
 */
const nav = [
  [
    'Getting started',
    [
      ['Introduction', '/docs'],
      ['Installation', '/docs/installation'],
      ['Your first editor', '/docs/first-editor'],
      ['Styling', '/docs/styling'],
    ],
  ],
  [
    'Frameworks',
    [
      ['All of them', '/docs/frameworks'],
      ['React', '/docs/react'],
      ['Vue', '/docs/vue'],
      ['Svelte', '/docs/svelte'],
      ['Solid', '/docs/solid'],
    ],
  ],
  [
    'Concepts',
    [
      ['Document model', '/docs/document-model'],
      ['Commands', '/docs/commands'],
      ['Position mapping', '/docs/position-mapping'],
      ['Writing an extension', '/docs/extensions'],
    ],
  ],
  [
    'Paid features',
    [
      ['AI', '/docs/ai'],
      ['Collaboration', '/docs/collab'],
      ['Version history', '/docs/versions'],
    ],
  ],
  [
    'Reference',
    [
      ['API', '/docs/api'],
      ['Every extension', '/docs/extension-reference'],
      ['Keyboard shortcuts', '/docs/shortcuts'],
      ['Recipes', '/docs/recipes'],
      ['Benchmarks', '/docs/benchmarks'],
      ['Docs for AI tools (MCP)', '/docs/mcp'],
    ],
  ],
] as const

/**
 * The extension pages are a third level in the sidebar.
 *
 * Eighty-one flat links would bury the twenty pages above them, so they are
 * grouped and collapsed, and only the group holding the current page is open.
 * Built from the generated data for the same reason the pages are: a list typed
 * here would drift from the extensions that actually ship.
 */
const { extensions } = api

const EXT_BASE = '/docs/extension-reference'
const extGroups = [
  ['Nodes', 'node'],
  ['Marks', 'mark'],
  ['Behaviour', 'extension'],
].map(([title, kind]) => ({
  title,
  items: extensions
    .filter((e) => e.kind === kind)
    .map((e) => [e.importName, `${EXT_BASE}/${e.importName}`] as [string, string]),
}))

const here = Astro.url.pathname.replace(/\/$/, '') || '/docs'
const flat = nav.flatMap(([, items]) =>
  (items as unknown as [string, string][]).flatMap((item) =>
    item[1] === EXT_BASE ? [item, ...extGroups.flatMap((g) => g.items)] : [item],
  ),
)
const index = flat.findIndex(([, href]) => href === here)
const previous = index > 0 ? flat[index - 1] : null
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : null
const source = `https://github.com/amrelaco/matra/edit/main/apps/site/src/pages${
  here === '/docs' ? '/docs/index' : here
}.astro`

/**
 * What this page is about, said in a form a machine can quote.
 *
 * The site-wide graph in `Base.astro` describes the product and repeats itself
 * on all thirty pages. An answer engine asked "how do Matra commands work"
 * needs to know that *this* page is the article about commands, and where it
 * sits — so every docs page carries a `TechArticle` pointing at the software it
 * documents, and the breadcrumbs that put it under /docs.
 */
const origin = (Astro.site ?? new URL('https://matrajs.com')).origin
const canonical = new URL(`${here}${here.endsWith('/') ? '' : '/'}`, origin).href

const crumbs = [
  { name: 'Matra', item: `${origin}/` },
  { name: 'Docs', item: `${origin}/docs/` },
  ...(here === '/docs' ? [] : [{ name: heading, item: canonical }]),
]

const schema = [
  {
    '@type': 'TechArticle',
    '@id': `${canonical}#article`,
    headline: heading,
    name: heading,
    description,
    url: canonical,
    articleSection: section,
    inLanguage: 'en',
    isPartOf: { '@id': 'https://matrajs.com/#website' },
    about: { '@id': 'https://matrajs.com/#software' },
    author: { '@id': 'https://matrajs.com/#org' },
    publisher: { '@id': 'https://matrajs.com/#org' },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumbs`,
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.item,
    })),
  },
]
---

<Base title={title} description={description} schema={schema}>
  <Nav />
  <!--
    The same ruled sheet as every other page: a section, with the rails running
    its full height. Docs used to be a free-floating grid with a different
    width and no rails, which made the documentation look like a different
    product from the page that sent you to it.
  -->
  <div class="section wide docs-shell">
    <aside class="docs-side">
      <nav aria-label="Documentation">
        {
          nav.map(([group, items]) => (
            <div class="docs-group">
              <div class="docs-group-name mono">{group}</div>
              {items.map(([label, href]) => (
                <>
                  <a
                    href={href}
                    class={href === here ? 'on' : ''}
                    aria-current={href === here ? 'page' : undefined}
                  >
                    {label}
                  </a>
                  {href === EXT_BASE &&
                    extGroups.map((sub) => (
                      <details class="docs-sub" open={sub.items.some(([, h]) => h === here)}>
                        <summary>
                          {sub.title} <span class="docs-sub-count">{sub.items.length}</span>
                        </summary>
                        {sub.items.map(([subLabel, subHref]) => (
                          <a
                            href={subHref}
                            class={subHref === here ? 'on' : ''}
                            aria-current={subHref === here ? 'page' : undefined}
                          >
                            {subLabel}
                          </a>
                        ))}
                      </details>
                    ))}
                </>
              ))}
            </div>
          ))
        }
      </nav>
    </aside>

    <main class="docs-article" id="article">
      <p class="docs-crumb mono">{section}</p>
      <h1>{heading}</h1>
      <slot />

      <nav class="docs-pager" aria-label="More documentation">
        {
          previous ? (
            <a href={previous[1]} class="docs-pager-link">
              <span class="mono">
                <Icon icon={ArrowLeft02Icon} size={13} />
                previous
              </span>
              <b>{previous[0]}</b>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={next[1]} class="docs-pager-link next">
              <span class="mono">
                next
                <Icon icon={ArrowRight02Icon} size={13} />
              </span>
              <b>{next[0]}</b>
            </a>
          )
        }
      </nav>

      <p class="docs-edit"><a href={source}>Edit this page on GitHub</a></p>
    </main>

    <aside class="docs-toc">
      <div class="docs-toc-inner">
        <div class="docs-group-name mono">On this page</div>
        <nav id="toc" aria-label="On this page"></nav>
      </div>
    </aside>
  </div>
  <Footer />

  <script>
    /**
     * Wire the article, on arrival and on every arrival after that.
     *
     * A module only ever runs once, so on a client-side navigation between two
     * docs pages this happened on whichever one you landed on first and never
     * again — leaving "On this page" with a heading and nothing under it, and
     * every code block without its copy button.
     */
    function wireArticle() {
      const article = document.getElementById('article')
      const toc = document.getElementById('toc')
      if (!article || !toc) return

      // Built from the article that actually rendered, so it cannot advertise
      // a heading that is not there.
      toc.replaceChildren()
      const headings = Array.from(article.querySelectorAll('h2'))
      for (const heading of headings) {
        if (!heading.id) {
          heading.id =
            heading.textContent
              ?.toLowerCase()
              .trim()
              .replace(/[^\p{L}\p{N}\s-]/gu, '')
              .replace(/\s+/g, '-') ?? ''
        }
        const link = document.createElement('a')
        link.href = `#${heading.id}`
        link.textContent = heading.textContent
        toc.appendChild(link)
      }

      const aside = toc.closest('.docs-toc')
      if (headings.length === 0) aside?.setAttribute('hidden', '')
      else aside?.removeAttribute('hidden')

      // Mark the section being read. A contents list that never says where you
      // are is a list of links, not a map.
      if ('IntersectionObserver' in window && headings.length > 0) {
        const links = new Map(
          Array.from(toc.querySelectorAll('a')).map((link) => [link.hash.slice(1), link]),
        )
        const seen = new Set()
        const watcher = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) seen.add(entry.target.id)
              else seen.delete(entry.target.id)
            }
            for (const [id, link] of links) link.classList.toggle('on', seen.has(id))
          },
          { rootMargin: '-80px 0px -70% 0px' },
        )
        for (const heading of headings) watcher.observe(heading)
      }

      // A copy button on every block. Docs that make you select code by hand
      // are docs nobody trusts.
      for (const block of article.querySelectorAll('pre')) {
        if (block.querySelector('.copy-code')) continue
        const button = document.createElement('button')
        button.className = 'copy-code'
        button.type = 'button'
        button.textContent = 'copy'
        button.addEventListener('click', async () => {
          await navigator.clipboard?.writeText(block.querySelector('code')?.textContent ?? '')
          button.textContent = 'copied'
          setTimeout(() => {
            button.textContent = 'copy'
          }, 1400)
        })
        block.appendChild(button)
      }
    }

    wireArticle()
    document.addEventListener('astro:page-load', wireArticle)
  </script>
</Base>
