---
import Footer from '../components/Footer.astro'
import Gallery from '../components/Gallery.astro'
import Nav from '../components/Nav.astro'
import Base from '../layouts/Base.astro'

/** Measured, not asserted. bench/browser, Safari, median of seven samples. */
const speed = [
  ['Mount and first render', '1.58 ms', '3.12 ms', '2.0× faster'],
  ['Keystroke, 200 paragraphs', '0.16 ms', '0.18 ms', '1.1× faster'],
  ['Keystroke, 2000 paragraphs', '0.84 ms', '0.84 ms', 'level'],
  ['Serialise to HTML', '1.41 ms', '1.76 ms', '1.25× faster'],
  ['Parse a document (Node)', '0.70 ms', '21.6 ms', '31× faster'],
]

const compare = [
  ['Bundle, gzipped', '21.9 kB', '117 kB', '~35 kB', '~50 kB'],
  ['Runtime dependencies', '0', '51 packages', 'a few', 'several'],
  ['Engine types in your code', 'none', 'ProseMirror', 'Lexical', 'Slate'],
  ['Command types', 'inferred', 'augmentation', 'manual', 'manual'],
  ['Async position safety', 'built in', 'manual', 'manual', 'manual'],
  ['Markdown without a DOM', 'yes', 'no', 'no', 'no'],
  ['Table of contents', 'free', 'paid', 'build it', 'build it'],
  ['Unique block ids', 'free', 'paid', 'build it', 'build it'],
  ['Drag handle', 'free', 'paid', 'build it', 'build it'],
  ['Comments', 'free', 'paid', 'build it', 'build it'],
  ['Runtime licence check', 'never', 'none', '—', '—'],
]

const extensions = [
  ['Text', 'bold, italic, strike, code, underline, highlight, sub, super, link'],
  ['Blocks', 'headings, quote, code block, rule, break, image'],
  ['Lists', 'bulleted, ordered, task lists with real checkboxes'],
  ['Tables', 'insert, delete, header rows, colspan and rowspan'],
  ['Writing', 'placeholder, character count, alignment, smart typography'],
  ['Structure', 'table of contents, unique block ids, drag handle'],
  ['Interchange', 'Markdown in and out, with no DOM'],
  ['Review', 'threaded comments anchored to ranges'],
]

const tiers = [
  {
    name: 'Core',
    price: '$0',
    unit: 'MIT, forever',
    tag: 'Everything most editors need, and no asterisk on any of it.',
    features: [
      'The whole engine, MIT',
      'Every node and mark',
      'Tables, comments, task lists',
      'Table of contents and block ids',
      'React, Vue and vanilla',
    ],
    cta: 'npm i @matrajs/core',
    href: 'https://github.com/amrelaco/matra',
  },
  {
    name: 'Pro',
    price: '$99',
    unit: 'per month, up to 5 developers',
    tag: 'For teams shipping AI or collaboration in production.',
    features: [
      'Everything in Core',
      'AI extension, streaming edits',
      'Collaboration and rebasing',
      'Remote cursors and presence',
      'Email support, 2 working days',
    ],
    cta: 'Start with Pro',
    href: '/contact?plan=pro',
    featured: true,
  },
  {
    name: 'Business',
    price: '$349',
    unit: 'per month, up to 25 developers',
    tag: 'When more than one team depends on it.',
    features: [
      'Everything in Pro',
      'Priority queue on issues',
      'Invoice billing and POs',
      'Security review answered',
      'A private channel with us',
    ],
    cta: 'Talk to us',
    href: '/contact',
  },
]

const faqs = [
  [
    'Is the core really MIT?',
    'Yes, and it stays that way. The engine, every node and mark, tables, comments, task lists, table of contents and block ids are MIT. Nothing gets moved out of the core later to be sold back.',
  ],
  [
    'Does anything phone home?',
    'No. There is no licence key, no telemetry and no runtime check — in development or in production. A lapsed subscription cannot switch anything off in an app you already shipped. What a subscription buys is access to install and to updates, through a private registry.',
  ],
  [
    'How is it this much smaller?',
    'It has no dependencies. The document model, transforms, position mapping, editor state and the editable view are written from scratch rather than assembled from ProseMirror. Nothing arrives that the editor does not use.',
  ],
  [
    'What is not built yet?',
    'Mentions, a bubble menu, and export to DOCX or PDF. The view passes its tests and has been measured in Safari, but it has not yet met real IME users on iOS and Android at scale — if you type Bangla, Chinese or Japanese, test it before you commit.',
  ],
  [
    'Who is behind it?',
    'Amrela, an AI product company in Dhaka. Matra is one of its products, and the same people answer the support email.',
  ],
]
---

<Base
  title="Matra — a headless rich text editor that is 21.9 kB"
  description="A headless rich text editor framework with zero dependencies. 21.9 kB gzipped against Tiptap's 117 kB, measured faster in the browser, and MIT at the core."
>
  <Nav />

  <!-- Hero -->
  <header class="section" style="border-top: none">
    <div class="wrap hero">
      <div class="hero-copy">
        <p class="kicker"><span class="dot"></span>v0.10 · zero dependencies</p>
        <h1>An editor that<br />weighs almost nothing.</h1>
        <p class="lede">
          A headless rich text editor framework with a first-class extension API.
          <strong>21.9 kB gzipped</strong> against Tiptap's 117, no runtime dependencies,
          and measured faster in a real browser — not asserted.
        </p>
        <div class="install-line">
          <code class="mono">npm i @matrajs/core</code>
          <button id="copy" class="copy mono" aria-label="Copy install command">copy</button>
        </div>
        <div class="cta">
          <a class="btn" href="#gallery">See five editors</a>
          <a class="btn ghost" href="#speed">See the numbers</a>
        </div>
        <ul class="proof">
          <li><b>21.9 kB</b><span>gzipped, with the starter kit</span></li>
          <li><b>0</b><span>runtime dependencies</span></li>
          <li><b>349</b><span>tests, 45 adversarial</span></li>
        </ul>
      </div>

      <div class="demo-shell">
        <div class="chrome">
          <span class="d" style="background: var(--dot-r)"></span>
          <span class="d" style="background: var(--dot-y)"></span>
          <span class="d" style="background: var(--dot-g)"></span>
          <span class="chrome-label mono">live — this is the editor, at its real size</span>
        </div>
        <div id="demo" class="demo"></div>
        <div class="demo-hint mono">Type. Use <b>Mod-B</b>, <b>Mod-I</b>, or start a line with <b>#</b> or <b>-</b>.</div>
      </div>
    </div>
  </header>

  <!-- Speed -->
  <section class="section" id="speed">
    <div class="wrap">
      <p class="kicker"><span class="dot"></span>Measured, not claimed</p>
      <h2>Faster where it is felt.</h2>
      <p class="lede">
        Safari, median of seven samples, against Tiptap 3.30 on the same document in the
        same browser. The harness is in the repository, so you can disagree with it.
      </p>
      <div class="meter">
        <div class="meter-cell">
          <b id="meter-key">measuring…</b>
          <span>per keystroke, 2,000 paragraphs</span>
        </div>
        <div class="meter-cell">
          <b id="meter-parse">—</b>
          <span>to parse that document</span>
        </div>
        <div class="meter-cell meter-note-cell">
          <span id="meter-note" class="mono">running in your browser…</span>
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Operation</th><th>Matra</th><th>Tiptap</th><th></th></tr>
          </thead>
          <tbody>
            {speed.map(([op, a, b, note]) => (
              <tr>
                <td>{op}</td>
                <td class="mono win">{a}</td>
                <td class="mono">{b}</td>
                <td class="note">{note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">
        Keystroke on a 2000-paragraph document sits between 0.90× and 1.01× of Tiptap across
        runs, so it is written down as level rather than ahead. A benchmark that only flatters
        the thing it measures is an advertisement.
      </p>
    </div>
  </section>

  <Gallery />

  <!-- Install -->
  <section class="section" id="install">
    <div class="wrap install-grid">
      <div>
        <p class="kicker"><span class="dot"></span>Three lines</p>
        <h2>The whole API,<br />more or less.</h2>
        <p class="lede">
          Extensions are plain objects. Command types are inferred from the array you pass in,
          so <span class="mono">editor.commands</span> knows what exists without a single
          declaration merge.
        </p>
      </div>
      <div class="code">
        <div class="chrome">
          <span class="d" style="background: var(--dot-r)"></span>
          <span class="d" style="background: var(--dot-y)"></span>
          <span class="d" style="background: var(--dot-g)"></span>
          <span class="chrome-label mono">editor.ts</span>
        </div>
        <pre class="mono"><code><span class="k">import</span> {'{'} createEditor, starterKit {'}'} <span class="k">from</span> <span class="s">'@matrajs/core'</span>

<span class="k">const</span> editor = createEditor({'{'}
  extensions: starterKit,
  content: <span class="s">'&lt;p&gt;Hello.&lt;/p&gt;'</span>,
{'}'})

editor.mount(document.querySelector(<span class="s">'#editor'</span>))
editor.commands.toggleBold()<span class="c"> // typed, inferred</span></code></pre>
      </div>
    </div>
  </section>

  <!-- Extensions -->
  <section class="section">
    <div class="wrap">
      <p class="kicker"><span class="dot"></span>In the box</p>
      <h2>Free includes the parts<br />others charge for.</h2>
      <p class="lede">
        Table of contents, unique block ids, the drag handle and comments are paid features
        elsewhere. They are MIT here, because the things that take a week should bring people
        in, and the two that took months are what pay for the work.
      </p>
      <div class="ext-grid">
        {extensions.map(([group, items]) => (
          <div class="card">
            <div class="ext-head mono">{group}</div>
            <p>{items}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section">
    <div class="wrap">
      <p class="kicker"><span class="dot"></span>Against the alternatives</p>
      <h2>An honest table.</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th></th><th>Matra</th><th>Tiptap</th><th>Lexical</th><th>Slate</th></tr>
          </thead>
          <tbody>
            {compare.map(([row, a, b, c, d]) => (
              <tr>
                <td>{row}</td>
                <td class="mono win">{a}</td>
                <td class="mono">{b}</td>
                <td class="mono">{c}</td>
                <td class="mono">{d}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="footnote">
        Where they win, and it is worth saying: ProseMirror's ecosystem is a decade deep and
        Tiptap inherits all of it, and Lexical has been hardened by Meta's traffic. If you need
        a mature extension for something exotic today, they have it and this does not.
      </p>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section" id="pricing">
    <div class="wrap">
      <p class="kicker"><span class="dot"></span>Pricing</p>
      <h2>The core is free forever.</h2>
      <p class="lede">
        Flat pricing, not per seat — one number your finance team can approve. Pay yearly and
        two months are free.
      </p>
      <div class="tiers">
        {tiers.map((tier) => (
          <div class={`tier ${tier.featured ? 'featured' : ''}`}>
            <div class="tier-head">
              <span class="mono tier-name">{tier.name}</span>
              {tier.featured && <span class="badge mono">Most teams</span>}
            </div>
            <div class="price"><b>{tier.price}</b><span>{tier.unit}</span></div>
            <p class="tier-tag">{tier.tag}</p>
            <a class={`btn ${tier.featured ? '' : 'ghost'}`} href={tier.href}>{tier.cta}</a>
            <ul>
              {tier.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="footnote">
        Nothing phones home and no licence check runs in production. A subscription buys access
        to install the paid packages and to their updates; the version you shipped keeps running
        whatever happens to your billing.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap">
      <p class="kicker"><span class="dot"></span>Questions</p>
      <h2>Answered plainly.</h2>
      <div class="faq">
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />

  <script>
    import '../scripts/gallery.ts'
    import { createEditor, starterKit } from '@matrajs/core'

    const copy = document.getElementById('copy')
    copy?.addEventListener('click', async () => {
      await navigator.clipboard?.writeText('npm i @matrajs/core')
      copy.textContent = 'copied'
      setTimeout(() => { copy.textContent = 'copy' }, 1400)
    })

    const element = document.getElementById('demo')
    if (element) {
      createEditor({
        extensions: starterKit,
        content:
          '<h2>Try it here.</h2>' +
          '<p>This is the editor, running at the size the table above claims. ' +
          'Everything you can do to this paragraph is in the free package.</p>' +
          '<ul><li>Press <strong>Mod-B</strong> for bold</li>' +
          '<li>Start a line with <strong>#</strong> for a heading</li>' +
          '<li>Start one with <strong>-</strong> for a list</li></ul>' +
          '<blockquote><p>Undo is one step per thing you did, not per keystroke.</p></blockquote>',
      }).mount(element)
    }
  </script>

  <style>
    .dot { width: 5px; height: 5px; background: var(--indigo); display: inline-block; }

    .hero { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; padding-top: 84px; padding-bottom: 84px; }
    .hero h1 { font-size: clamp(42px, 5.2vw, 68px); margin: 18px 0 20px; }
    .hero .lede strong { color: var(--ink); font-weight: 600; }
    .install-line { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 26px; border: 1px dashed var(--rule-strong); background: var(--surface); padding: 11px 13px; }
    .install-line code { font-size: 13.5px; color: var(--ink); }
    .copy { background: transparent; border: 1px solid var(--rule-strong); color: var(--ink-faint); font-size: 11px; padding: 4px 9px; cursor: pointer; }
    .copy:hover { color: var(--ink); }
    .cta { display: flex; gap: 12px; margin: 16px 0 34px; flex-wrap: wrap; }
    .proof { list-style: none; margin: 0; padding: 22px 0 0; border-top: 1px dashed var(--rule-strong); display: flex; gap: 34px; flex-wrap: wrap; }
    .proof li { display: flex; flex-direction: column; }
    .proof b { font-family: var(--font-display); font-size: 27px; font-weight: 400; }
    .proof span { font-size: 12px; color: var(--ink-faint); }

    .demo-shell { border: 1px dashed var(--rule-strong); background: var(--surface); }
    .chrome { display: flex; align-items: center; gap: 6px; padding: 9px 13px; background: var(--code-chrome); border-bottom: 1px dashed var(--rule); }
    .chrome .d { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
    .chrome-label { font-size: 10.5px; color: var(--code-com); margin-left: 8px; }
    .demo { padding: 20px 22px; min-height: 300px; font-size: 15px; }
    .demo :global([contenteditable]) { outline: none; }
    .demo :global(h2) { font-size: 25px; margin: 0 0 12px; }
    .demo :global(p) { margin: 0 0 12px; }
    .demo :global(ul) { margin: 0 0 12px; padding-left: 20px; }
    .demo :global(blockquote) { margin: 0; padding-left: 14px; border-left: 2px solid var(--indigo); color: var(--ink-soft); }
    .demo-hint { padding: 10px 14px; border-top: 1px dashed var(--rule); font-size: 11px; color: var(--ink-faint); }

    .meter { display: flex; gap: 0; margin-top: 28px; border: 1px dashed var(--rule-strong); background: var(--surface); flex-wrap: wrap; }
    .meter-cell { flex: 1 1 190px; padding: 18px 20px; border-right: 1px dashed var(--rule-strong); display: flex; flex-direction: column; gap: 5px; }
    .meter-cell:last-child { border-right: none; }
    .meter-cell b { font-family: var(--font-display); font-size: 32px; font-weight: 400; line-height: 1; color: var(--indigo); }
    .meter-cell span { font-size: 12px; color: var(--ink-faint); }
    .meter-note-cell { justify-content: center; }

    .table-wrap { overflow-x: auto; margin-top: 26px; }
    td.note { color: var(--ink-faint); font-size: 13px; }
    .footnote { color: var(--ink-faint); font-size: 13px; max-width: 70ch; margin-top: 20px; }

    .install-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 48px; align-items: center; }
    .code { border: 1px dashed var(--rule-strong); background: var(--code-bg); }
    .code pre { margin: 0; padding: 18px; overflow-x: auto; font-size: 12.5px; line-height: 1.75; color: var(--code-fg); }
    .code .k { color: var(--code-key); }
    .code .s { color: var(--code-str); }
    .code .c { color: var(--code-com); }

    .ext-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 30px; }
    .ext-head { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--indigo); margin-bottom: 7px; }
    .ext-grid p { margin: 0; font-size: 13.5px; color: var(--ink-soft); }

    .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 30px; }
    .tier { border: 1px dashed var(--rule-strong); padding: 24px; display: flex; flex-direction: column; }
    .tier.featured { background: var(--invert-bg); color: var(--invert-fg); border-style: solid; border-color: var(--invert-bg); }
    .tier.featured .tier-tag, .tier.featured li { color: var(--invert-soft); }
    .tier.featured .btn { background: var(--invert-fg); color: var(--invert-bg); border-color: var(--invert-fg); }
    .tier-head { display: flex; align-items: center; justify-content: space-between; }
    .tier-name { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
    .badge { font-size: 10px; border: 1px solid currentColor; padding: 3px 7px; opacity: 0.8; }
    .price { margin: 16px 0 10px; display: flex; flex-direction: column; }
    .price b { font-family: var(--font-display); font-size: 42px; font-weight: 400; line-height: 1; }
    .price span { font-size: 12px; color: var(--ink-faint); margin-top: 6px; }
    .tier.featured .price span { color: var(--invert-soft); }
    .tier-tag { font-size: 13.5px; color: var(--ink-soft); min-height: 42px; }
    .tier ul { list-style: none; margin: 20px 0 0; padding: 18px 0 0; border-top: 1px dashed currentColor; font-size: 13.5px; color: var(--ink-soft); }
    .tier li { padding: 5px 0 5px 18px; position: relative; }
    .tier li::before { content: '·'; position: absolute; left: 4px; color: var(--indigo); font-weight: 700; }
    .tier .btn { justify-content: center; margin-top: 4px; }

    .faq { margin-top: 26px; border-top: 1px dashed var(--rule); }
    details { border-bottom: 1px dashed var(--rule); padding: 16px 0; }
    summary { cursor: pointer; font-size: 16px; list-style: none; display: flex; justify-content: space-between; align-items: center; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; color: var(--ink-faint); font-family: var(--font-mono); }
    details[open] summary::after { content: '−'; }
    details p { color: var(--ink-soft); font-size: 14.5px; max-width: 72ch; margin: 12px 0 0; }

    @media (max-width: 940px) {
      .hero, .install-grid { grid-template-columns: 1fr; gap: 36px; }
      .ext-grid { grid-template-columns: repeat(2, 1fr); }
      .tiers { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) {
      .ext-grid { grid-template-columns: 1fr; }
      .foot-cols { gap: 30px; flex-wrap: wrap; }
    }
  </style>
</Base>
