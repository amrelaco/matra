---
import Footer from '../components/Footer.astro'
import Logo from '../components/Logo.astro'
import Nav from '../components/Nav.astro'
import Base from '../layouts/Base.astro'

/**
 * One column width for every section, so the page has a single left edge.
 *
 * Each section answers one question and stops. The five editor sections come
 * one after another on scroll rather than behind tabs — a tab is a thing nobody
 * clicks, and the whole argument is that the same package makes all of them.
 */

const speed = [
  ['Mount and first render', '1.58', '3.12', '2.0× faster'],
  ['Keystroke, 200 paragraphs', '0.16', '0.18', '1.1× faster'],
  ['Keystroke, 2000 paragraphs', '0.84', '0.84', 'level'],
  ['Serialise to HTML', '1.41', '1.76', '1.25× faster'],
  ['Parse a document', '0.70', '21.6', '31× faster'],
]

const compare = [
  ['Bundle, gzipped', '22.3 kB', '117 kB', '~35 kB', '~50 kB'],
  ['Runtime dependencies', 'none', '51 packages', 'a few', 'several'],
  ['Engine types in your code', 'none', 'ProseMirror', 'Lexical', 'Slate'],
  ['Command types', 'inferred', 'augmentation', 'manual', 'manual'],
  ['Async position safety', 'built in', 'manual', 'manual', 'manual'],
  ['Markdown without a DOM', 'yes', 'no', 'no', 'no'],
  ['Table of contents', 'free', 'paid', 'build it', 'build it'],
  ['Unique block ids', 'free', 'paid', 'build it', 'build it'],
  ['Drag handle', 'free', 'paid', 'build it', 'build it'],
  ['Comments', 'free', 'paid', 'build it', 'build it'],
  ['Runtime licence check', 'never', 'none', '—', '—'],
]

const included = [
  ['Text', 'bold, italic, strike, code, underline, highlight, sub, super, link'],
  ['Blocks', 'headings, quote, code block, rule, break, image'],
  ['Lists', 'bulleted, ordered, task lists with real checkboxes'],
  ['Tables', 'insert, delete, header rows, colspan kept'],
  ['Writing', 'placeholder, character count, alignment, smart typography'],
  ['Structure', 'table of contents, unique block ids, drag handle'],
  ['Interchange', 'Markdown in and out, with no DOM'],
  ['Review', 'threaded comments anchored to ranges'],
]
---

<Base
  title="Matra — the editor you are already using"
  description="A headless rich text editor framework. 22.3 kB gzipped, zero dependencies, measured faster than Tiptap in a real browser. Every word on this page is running it."
>
  <Nav />

  <!-- 1. What it is -->
  <header class="section flush">
    <div class="wrap hero">
      <h1>The editor you are<br />already using.</h1>
      <p class="lede">
        Every word on this page is a Matra document. Select this sentence and press
        <strong>Mod-B</strong>. Type <strong>"quotes"</strong> and watch them curl. Nothing here
        is a screenshot and nothing is a video — it is the product, at the size the table
        further down claims.
      </p>

      <div class="cta" data-static>
        <a class="btn" href="/docs">Read the docs</a>
        <a class="btn ghost" href="#editors">See five editors</a>
      </div>

      <div class="install" data-static>
        <code class="mono">npm i @matrajs/core</code>
        <button id="copy" class="copy mono" type="button" aria-label="Copy install command">
          copy
        </button>
      </div>

      <ul class="proof" data-static>
        <li><b>22.3 kB</b><span>gzipped, with the starter kit</span></li>
        <li><b>0</b><span>runtime dependencies</span></li>
        <li><b>384</b><span>tests, 45 adversarial</span></li>
        <li><b>MIT</b><span>core, permanently</span></li>
      </ul>
    </div>
  </header>

  <!-- 2. Proof that it is really running -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">A document, not a demo</p>
      <h2>Everything here is editable.</h2>
      <p class="lede">
        This block has the whole extension set on. Start a line with <code>#</code>,
        <code>-</code> or <code>[]</code>. Press Mod-B, Mod-I, Mod-Z. Break it however you like;
        a reload puts it back.
      </p>

      <div class="paper" data-editable="full">
        <h3>Try it properly</h3>
        <p>
          Undo groups by what you did rather than by keystroke, so one Mod-Z takes back a whole
          word instead of one letter. Typing "smart quotes" curls them, and two hyphens -- become
          an em dash.
        </p>
        <ul data-type="taskList">
          <li data-checked="true"><p>Tick this — it is a real node, not a glyph</p></li>
          <li data-checked="false"><p>Add a line and watch the list continue</p></li>
        </ul>
        <blockquote>
          <p>A quote, because a quote is a block and blocks are what this is made of.</p>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- 3–7. The same package, five shapes -->
  <section class="section" id="editors">
    <div class="wrap">
      <p class="kicker">Headless, demonstrated</p>
      <h2>One package,<br />five different editors.</h2>
      <p class="lede">
        None of these is a theme or a preset. Each is <span class="mono">createEditor</span> with
        a different array of extensions and different CSS around it. All five are live, and all
        five share one 22 kB download.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">01 — Block editor</p>
        <h3>The Notion shape.</h3>
        <p>
          Placeholder, task lists, smart typography. What most people picture when they say they
          want an editor.
        </p>
        <p class="mono packages">starterKit · taskList · typography · placeholder</p>
      </div>
      <div class="demo-stage">
        <div id="ed-notion" class="ed-notion"></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">02 — Comment box</p>
        <h3>Three marks, deliberately.</h3>
        <p>
          Bold, italic, code, and nothing else. A comment box that can make headings is a bug
          report waiting to happen.
        </p>
        <p class="mono packages">document · paragraph · text · bold · italic · code</p>
      </div>
      <div class="demo-stage">
        <div class="comment-shell">
          <div class="comment-head" data-static>
            <span class="avatar">N</span><span>Nahim commented</span>
          </div>
          <div id="ed-comment" class="ed-comment"></div>
          <div class="comment-foot" data-static>
            <div class="tools">
              <button data-cmd="toggleBold" data-for="comment"><b>B</b></button>
              <button data-cmd="toggleItalic" data-for="comment"><i>I</i></button>
              <button data-cmd="toggleCode" data-for="comment" class="mono">&lt;/&gt;</button>
            </div>
            <div class="right">
              <span id="count-comment" class="mono count">0 characters</span>
              <button class="post">Post</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">03 — Document</p>
        <h3>A toolbar over a page.</h3>
        <p>
          Headings, quotes, tables, undo. Every button above the page is a command call, and the
          command types come from the array of extensions rather than from a declaration.
        </p>
        <p class="mono packages">starterKit · tableKit · typography</p>
      </div>
      <div class="demo-stage">
        <div class="docs-shell-demo">
          <div class="toolbar" data-static>
            <button data-cmd="toggleBold" data-for="docs">B</button>
            <button data-cmd="toggleItalic" data-for="docs"><i>I</i></button>
            <span class="sep"></span>
            <button data-cmd="toggleHeading" data-arg="2" data-for="docs">H2</button>
            <button data-cmd="toggleBulletList" data-for="docs">List</button>
            <button data-cmd="toggleBlockquote" data-for="docs">Quote</button>
            <span class="sep"></span>
            <button data-cmd="undo" data-for="docs">Undo</button>
          </div>
          <div class="page"><div id="ed-docs" class="ed-docs"></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">04 — Markdown</p>
        <h3>Out, without a DOM.</h3>
        <p>
          The panel beside this is <span class="mono">toMarkdown</span> running on every
          keystroke. It never touches the DOM, so the same call runs on a server with no jsdom
          in sight.
        </p>
        <p class="mono packages">starterKit · taskList · toMarkdown</p>
      </div>
      <div class="demo-stage">
        <div class="md-shell">
          <div class="md-side"><div id="ed-markdown" class="ed-md"></div></div>
          <div class="md-out" data-static>
            <div class="md-label mono">toMarkdown()</div>
            <pre id="md-output" class="mono"></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">05 — Chat composer</p>
        <h3>One block, and a send key.</h3>
        <p>
          No headings, no lists, no way to paste a document into a message box. Constraining an
          editor is the same work as extending one.
        </p>
        <p class="mono packages">document · paragraph · text · bold · italic · hardBreak</p>
      </div>
      <div class="demo-stage">
        <div class="chat-shell" data-static>
          <div class="chat-log">
            <div class="bubble them">Did the drag handle land?</div>
            <div class="bubble me">It did — and it is free, which Tiptap's is not.</div>
          </div>
          <div class="chat-box">
            <div id="ed-chat" class="ed-chat"></div>
            <button class="send" aria-label="Send">↑</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Is it fast -->
  <section class="section" id="speed">
    <div class="wrap">
      <p class="kicker">Measured, not claimed</p>
      <h2>Faster where it is felt.</h2>
      <p class="lede">
        Safari, median of seven samples, against Tiptap 3.30 on the same document in the same
        browser. The harness is in the repository, so you are welcome to disagree with it.
      </p>

      <div class="meter" data-static>
        <div><b id="meter-key">measuring…</b><span>per keystroke, 2,000 paragraphs</span></div>
        <div><b id="meter-parse">—</b><span>to parse that document</span></div>
        <div class="note"><span id="meter-note" class="mono">running in your browser…</span></div>
      </div>

      <div class="scroll" data-static>
        <table>
          <thead><tr><th>Operation</th><th>Matra</th><th>Tiptap</th><th></th></tr></thead>
          <tbody>
            {speed.map(([op, a, b, note]) => (
              <tr>
                <td>{op}</td>
                <td class="mono win">{a} ms</td>
                <td class="mono dim">{b} ms</td>
                <td class="dim small">{note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="foot-note">
        Keystroke on a 2000-paragraph document sits between 0.90× and 1.01× of Tiptap across
        runs, so it is written down as level rather than ahead. A benchmark that only flatters
        the thing it measures is an advertisement.
      </p>
    </div>
  </section>

  <!-- 9. What you get -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">In the box</p>
      <h2>Free includes the parts<br />others charge for.</h2>
      <p class="lede">
        Table of contents, unique block ids, the drag handle and comments are paid features
        elsewhere. They are MIT here — the things that take a week should bring people in, and
        the two that took months are what pay for the work.
      </p>
      <div class="grid" data-static>
        {included.map(([group, items]) => (
          <article class="cell">
            <div class="cell-head mono">{group}</div>
            <p>{items}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. How it reads in code -->
  <section class="section">
    <div class="wrap two">
      <div>
        <p class="kicker">Three lines</p>
        <h2>The whole API,<br />more or less.</h2>
        <p class="lede">
          Extensions are plain objects. Command types are inferred from the array you pass in, so
          <span class="mono">editor.commands</span> knows what exists without a declaration
          merge.
        </p>
        <a class="btn ghost" href="/docs/first-editor" data-static>Your first editor</a>
      </div>
      <div class="code" data-static>
        <div class="chrome">
          <span class="d" style="background: var(--dot-r)"></span>
          <span class="d" style="background: var(--dot-y)"></span>
          <span class="d" style="background: var(--dot-g)"></span>
          <span class="mono file">editor.ts</span>
        </div>
        <pre class="mono"><code><span class="k">import</span> {'{'} createEditor, starterKit {'}'} <span class="k">from</span> <span class="s">'@matrajs/core'</span>

<span class="k">const</span> editor = createEditor({'{'}
  extensions: starterKit,
  content: <span class="s">'&lt;p&gt;Hello.&lt;/p&gt;'</span>,
{'}'})

editor.mount(document.querySelector(<span class="s">'#editor'</span>))
editor.commands.toggleBold()<span class="c"> // typed, inferred</span></code></pre>
      </div>
    </div>
  </section>

  <!-- 11. Where it sits -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">Against the alternatives</p>
      <h2>An honest table.</h2>
      <div class="scroll" data-static>
        <table>
          <thead>
            <tr><th></th><th>Matra</th><th>Tiptap</th><th>Lexical</th><th>Slate</th></tr>
          </thead>
          <tbody>
            {compare.map(([row, a, b, c, d]) => (
              <tr>
                <td>{row}</td>
                <td class="mono win">{a}</td>
                <td class="mono dim">{b}</td>
                <td class="mono dim">{c}</td>
                <td class="mono dim">{d}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="foot-note">
        Where they win, and it is worth saying: ProseMirror's ecosystem is a decade deep and
        Tiptap inherits all of it, and Lexical has been hardened by Meta's traffic. If you need a
        mature extension for something exotic today, they have it and this does not.
      </p>
    </div>
  </section>

  <!-- 12. What to do next -->
  <section class="section">
    <div class="wrap close">
      <div class="close-mark" data-static><Logo size={34} /></div>
      <h2>The core is MIT,<br />and stays that way.</h2>
      <p class="lede">
        AI and collaboration are what a subscription is for. Everything else, permanently, is
        not.
      </p>
      <div class="cta" data-static>
        <a class="btn" href="/docs">Get started</a>
        <a class="btn ghost" href="/pricing">Pricing</a>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    import '../scripts/demos.ts'
  </script>

  <style>
    .flush { border-top: none; }
    .hero { padding-top: var(--s5); }
    .hero .lede { font-size: 19px; max-width: 58ch; }
    .hero .lede strong { color: var(--ink); font-weight: 500; }

    .cta { display: flex; gap: 12px; margin-top: var(--s4); flex-wrap: wrap; }
    .install {
      display: flex; align-items: center; justify-content: space-between; gap: 14px;
      margin-top: var(--s3); border: 1px dashed var(--rule-strong);
      background: var(--surface); padding: 14px 16px; max-width: 400px;
    }
    .install code { font-size: 14px; }
    .copy { background: none; border: 1px solid var(--rule-strong); color: var(--ink-faint); font-size: 11px; padding: 5px 10px; cursor: pointer; }
    .copy:hover { color: var(--ink); }

    .proof {
      list-style: none; margin: var(--s5) 0 0; padding: var(--s3) 0 0;
      border-top: 1px dashed var(--rule-strong);
      display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s3);
    }
    .proof li { display: flex; flex-direction: column; gap: 5px; }
    .proof b { font-family: var(--font-display); font-size: 38px; line-height: 1; letter-spacing: -0.02em; }
    .proof span { font-size: 12.5px; color: var(--ink-faint); }

    .paper {
      margin-top: var(--s4); border: 1px dashed var(--rule-strong);
      background: var(--surface); padding: var(--s4);
    }
    .paper h3 { margin-bottom: var(--s2); }
    .paper p { margin: 0 0 var(--s2); }
    .paper code { font-family: var(--font-mono); font-size: 13.5px; background: var(--surface-2); padding: 1px 6px; }
    .paper ul { margin: 0 0 var(--s2); padding-left: 0; list-style: none; }
    .paper li { display: flex; gap: 10px; align-items: flex-start; }
    .paper li p { margin: 0; }
    .paper blockquote { margin: 0; padding-left: 16px; border-left: 2px solid var(--indigo); color: var(--ink-soft); }

    .demo-row { display: grid; grid-template-columns: 380px minmax(0, 1fr); gap: var(--s5); align-items: start; }
    .demo-copy h3 { margin-bottom: var(--s2); }
    .demo-copy p { color: var(--ink-soft); font-size: 15.5px; margin: 0 0 var(--s2); }
    .packages { font-size: 11px; color: var(--ink-faint); letter-spacing: 0.02em; }
    .demo-stage { border: 1px dashed var(--rule-strong); background: var(--surface); padding: var(--s3); }

    .ed-notion { font-size: 16px; min-height: 200px; }
    .ed-notion :global(h1) { font-family: var(--font-display); font-size: 30px; margin: 0 0 6px; }
    .ed-notion :global(p) { margin: 0 0 4px; }
    .ed-notion :global(ul) { list-style: none; padding-left: 0; margin: 6px 0; }
    .ed-notion :global(li) { display: flex; gap: 9px; align-items: flex-start; }
    .ed-notion :global(li p) { margin: 0; }
    .ed-notion :global([data-checked='true']) { color: var(--ink-faint); text-decoration: line-through; }

    .comment-shell { border: 1px solid var(--rule-strong); background: var(--paper); max-width: 520px; }
    .comment-head { display: flex; align-items: center; gap: 9px; padding: 11px 14px; border-bottom: 1px solid var(--rule); font-size: 13px; color: var(--ink-soft); }
    .avatar { width: 24px; height: 24px; background: var(--indigo); color: #fff; display: grid; place-items: center; font-size: 12px; border-radius: 50%; }
    .ed-comment { padding: 13px 14px; min-height: 80px; font-size: 14.5px; }
    .ed-comment :global(p) { margin: 0 0 8px; }
    .ed-comment :global(code) { background: var(--surface-2); padding: 1px 5px; font-family: var(--font-mono); font-size: 12.5px; }
    .comment-foot { display: flex; justify-content: space-between; align-items: center; padding: 9px 12px; border-top: 1px solid var(--rule); }
    .tools { display: flex; gap: 4px; }
    .tools button, .toolbar button { background: none; border: 1px solid transparent; padding: 4px 9px; cursor: pointer; color: var(--ink-soft); font-size: 13px; font-family: inherit; }
    .tools button:hover, .toolbar button:hover { border-color: var(--rule-strong); color: var(--ink); }
    .right { display: flex; align-items: center; gap: 12px; }
    .count { font-size: 11px; color: var(--ink-faint); }
    .post, .send { background: var(--indigo); color: #fff; border: none; padding: 6px 15px; font-size: 13px; cursor: pointer; }

    .docs-shell-demo { border: 1px solid var(--rule-strong); background: var(--surface-2); }
    .toolbar { display: flex; align-items: center; gap: 2px; padding: 7px 10px; border-bottom: 1px solid var(--rule); flex-wrap: wrap; }
    .sep { width: 1px; height: 16px; background: var(--rule-strong); margin: 0 6px; }
    .page { padding: var(--s3); display: flex; justify-content: center; }
    .ed-docs { background: var(--paper); width: 100%; max-width: 520px; padding: 30px 34px; min-height: 190px; font-size: 15px; }
    .ed-docs :global(h2) { font-family: var(--font-display); font-size: 24px; margin: 0 0 8px; }
    .ed-docs :global(p) { margin: 0 0 10px; }
    .ed-docs :global(blockquote) { border-left: 3px solid var(--indigo); margin: 0 0 10px; padding-left: 13px; color: var(--ink-soft); }

    .md-shell { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--rule-strong); }
    .md-out { border-left: 1px dashed var(--rule-strong); background: var(--code-bg); }
    .md-label { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); padding: 9px 14px; border-bottom: 1px dashed var(--rule); }
    .ed-md { padding: 15px; min-height: 210px; font-size: 14.5px; }
    .ed-md :global(p) { margin: 0 0 9px; }
    .ed-md :global(h2) { font-family: var(--font-display); font-size: 21px; margin: 0 0 8px; }
    .ed-md :global(ul) { margin: 0 0 9px; padding-left: 19px; }
    #md-output { margin: 0; padding: 15px; font-size: 12px; line-height: 1.7; color: var(--code-fg); white-space: pre-wrap; min-height: 210px; }

    .chat-shell { max-width: 460px; }
    .chat-log { display: flex; flex-direction: column; gap: 9px; margin-bottom: 13px; }
    .bubble { padding: 9px 13px; font-size: 14px; max-width: 78%; }
    .bubble.them { background: var(--surface-2); align-self: flex-start; }
    .bubble.me { background: var(--indigo); color: #fff; align-self: flex-end; }
    .chat-box { display: flex; align-items: flex-end; gap: 8px; border: 1px solid var(--rule-strong); background: var(--paper); padding: 8px 8px 8px 13px; border-radius: 22px; }
    .ed-chat { flex: 1; font-size: 14.5px; max-height: 100px; overflow-y: auto; }
    .ed-chat :global(p) { margin: 0; }
    .send { border-radius: 50%; width: 30px; height: 30px; padding: 0; flex: none; }

    .meter { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: var(--s4); border: 1px dashed var(--rule-strong); background: var(--surface); }
    .meter > div { padding: var(--s3); border-right: 1px dashed var(--rule-strong); display: flex; flex-direction: column; gap: 6px; }
    .meter > div:last-child { border-right: none; justify-content: center; }
    .meter b { font-family: var(--font-display); font-size: 38px; line-height: 1; color: var(--indigo); letter-spacing: -0.02em; }
    .meter span { font-size: 12.5px; color: var(--ink-faint); }

    .scroll { overflow-x: auto; margin-top: var(--s4); }
    td.win { color: var(--indigo); font-weight: 500; }
    td.dim { color: var(--ink-soft); }
    td.small { font-size: 13px; color: var(--ink-faint); }
    .foot-note { color: var(--ink-faint); font-size: 13.5px; max-width: 72ch; margin-top: var(--s3); }

    .grid { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: var(--s4); border-top: 1px dashed var(--rule-strong); border-left: 1px dashed var(--rule-strong); }
    .cell { padding: var(--s3); border-right: 1px dashed var(--rule-strong); border-bottom: 1px dashed var(--rule-strong); }
    .cell-head { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--indigo); margin-bottom: 9px; }
    .cell p { font-size: 13.5px; color: var(--ink-soft); margin: 0; }

    .two { display: grid; grid-template-columns: 1fr 1.05fr; gap: var(--s5); align-items: center; }
