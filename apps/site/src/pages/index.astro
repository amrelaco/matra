---
import Footer from '../components/Footer.astro'
import Logo from '../components/Logo.astro'
import Nav from '../components/Nav.astro'
import Base from '../layouts/Base.astro'

/**
 * Structure follows what the category does — hero, proof, capabilities, code,
 * comparison, pricing, close — with one deliberate difference. Tiptap and
 * BlockNote put no live editor on their landing page at all; Plate puts one in
 * the hero. This page has no separate demo, because the page is the demo.
 */

const speed = [
  ['Mount and first render', '1.58', '3.12', '2.0× faster'],
  ['Keystroke, 200 paragraphs', '0.16', '0.18', '1.1× faster'],
  ['Keystroke, 2000 paragraphs', '0.84', '0.84', 'level'],
  ['Serialise to HTML', '1.41', '1.76', '1.25× faster'],
  ['Parse a document', '0.70', '21.6', '31× faster'],
]

const compare = [
  ['Bundle, gzipped', '22.3 kB', '117 kB', '~35 kB', '~50 kB'],
  ['Runtime dependencies', 'none', '51 packages', 'a few', 'several'],
  ['Engine types in your code', 'none', 'ProseMirror', 'Lexical', 'Slate'],
  ['Command types', 'inferred', 'augmentation', 'manual', 'manual'],
  ['Async position safety', 'built in', 'manual', 'manual', 'manual'],
  ['Markdown without a DOM', 'yes', 'no', 'no', 'no'],
  ['Table of contents', 'free', 'paid', 'build it', 'build it'],
  ['Unique block ids', 'free', 'paid', 'build it', 'build it'],
  ['Drag handle', 'free', 'paid', 'build it', 'build it'],
  ['Comments', 'free', 'paid', 'build it', 'build it'],
  ['Runtime licence check', 'never', 'none', '—', '—'],
]

const capabilities = [
  [
    'Document model',
    'Plain JSON. No class to import, no engine type in any signature you write.',
    'document-model',
  ],
  [
    'Extensions',
    'Objects, not classes. Command types are inferred from the array you pass in.',
    'extensions',
  ],
  [
    'Position mapping',
    'Built in, so a late AI response lands where it was meant to rather than where it was aimed.',
    'position-mapping',
  ],
  ['Collaboration', 'An authority and step rebasing. No CRDT, and no dependency.', null],
  ['Markdown', 'In and out, with no DOM — so the same call runs on a server.', 'recipes'],
  [
    'Security',
    'One gate every route into the DOM passes through: JSON, paste, command, decoration.',
    null,
  ],
]
---

<Base
  title="Matra — the editor you are already using"
  description="A headless rich text editor framework. 22.3 kB gzipped, zero dependencies, measured faster than Tiptap in a real browser. Every word on this page is running it."
>
  <Nav />

  <!-- Hero -->
  <header class="hero-section">
    <div class="wrap hero">
      <div class="hero-mark"><Logo size={44} /></div>

      <div data-editable="typography" data-hint="typography extension">
        <h1>The editor you are<br />already using.</h1>
      </div>

      <div class="lede-wrap" data-editable="typography" data-hint="try typing here">
        <p class="lede">
          Every word on this page is a Matra document. Select this sentence and press
          <strong>Mod-B</strong>. Type <strong>"quotes"</strong> and watch them curl. Nothing
          here is a screenshot, and nothing is a video — it is the product, at the size the
          table below claims.
        </p>
      </div>

      <div class="cta">
        <a class="btn" href="/docs">Read the docs</a>
        <a class="btn ghost" href="#speed">See the numbers</a>
      </div>

      <div class="install">
        <code class="mono">npm i @matrajs/core</code>
        <button id="copy" class="copy mono" type="button" aria-label="Copy install command">
          copy
        </button>
      </div>

      <ul class="proof">
        <li><b>22.3 kB</b><span>gzipped, with the starter kit</span></li>
        <li><b>0</b><span>runtime dependencies</span></li>
        <li><b>384</b><span>tests, 45 adversarial</span></li>
        <li><b>MIT</b><span>core, permanently</span></li>
      </ul>
    </div>
  </header>

  <!-- Playground -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">A document, not a demo</p>
      <h2>Everything below is editable.</h2>
      <p class="lede">
        This block runs the full extension set — headings, lists, quotes, code, links, task
        lists, smart typography. Break it however you like; a reload puts it back.
      </p>

      <div class="paper" data-editable="full" data-hint="starter kit + typography + tasks">
        <h3>Try it properly</h3>
        <p>
          Start a line with <code>#</code> for a heading, <code>-</code> for a list, or
          <code>[]</code> for a checkbox. Press <strong>Mod-B</strong>, <strong>Mod-I</strong>,
          <strong>Mod-K</strong>. Undo groups by what you did rather than by keystroke, so one
          Mod-Z takes back a whole word.
        </p>
        <ul data-type="taskList">
          <li data-checked="true"><p>Tick this — it is a real node, not a glyph</p></li>
          <li data-checked="false"><p>Drag a paragraph by its handle</p></li>
        </ul>
        <blockquote>
          <p>
            Typing "smart quotes" here curls them, and two hyphens -- become an em dash, because
            the typography extension is on in this block and not in the heading above it.
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Speed -->
  <section class="section" id="speed">
    <div class="wrap">
      <p class="kicker">Measured, not claimed</p>
      <h2>Faster where it is felt.</h2>
      <p class="lede">
        Safari, median of seven samples, against Tiptap 3.30 on the same document in the same
        browser. The harness is in the repository, so you are welcome to disagree with it.
      </p>

      <div class="meter">
        <div><b id="meter-key">measuring…</b><span>per keystroke, 2,000 paragraphs</span></div>
        <div><b id="meter-parse">—</b><span>to parse that document</span></div>
        <div class="meter-note"><span id="meter-note" class="mono">running in your browser…</span></div>
      </div>

      <div class="scroll">
        <table>
          <thead>
            <tr><th>Operation</th><th>Matra</th><th>Tiptap</th><th></th></tr>
          </thead>
          <tbody>
            {speed.map(([op, a, b, note]) => (
              <tr>
                <td>{op}</td>
                <td class="mono win">{a} ms</td>
                <td class="mono dim">{b} ms</td>
                <td class="dim small">{note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="foot-note">
        Keystroke on a 2000-paragraph document sits between 0.90× and 1.01× of Tiptap across
        runs, so it is written down as level rather than ahead. A benchmark that only flatters
        the thing it measures is an advertisement.
      </p>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">What is in it</p>
      <h2>Six things that matter,<br />and no ceremony.</h2>

      <div class="grid">
        {capabilities.map(([title, body, href]) => (
          <article class="cell">
            <h3>{title}</h3>
            <p>{body}</p>
            {href && <a class="more mono" href={`/docs/${href}`}>Read more →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Code -->
  <section class="section">
    <div class="wrap two">
      <div>
        <p class="kicker">Three lines</p>
        <h2>The whole API,<br />more or less.</h2>
        <p class="lede">
          Extensions are plain objects. Command types are inferred from the array you pass in, so
          <span class="mono">editor.commands</span> knows what exists without a single
          declaration merge.
        </p>
        <a class="btn ghost" href="/docs/first-editor">Your first editor</a>
      </div>

      <div class="code">
        <div class="chrome">
          <span class="d" style="background: var(--dot-r)"></span>
          <span class="d" style="background: var(--dot-y)"></span>
          <span class="d" style="background: var(--dot-g)"></span>
          <span class="mono file">editor.ts</span>
        </div>
        <pre class="mono"><code><span class="k">import</span> {'{'} createEditor, starterKit {'}'} <span class="k">from</span> <span class="s">'@matrajs/core'</span>

<span class="k">const</span> editor = createEditor({'{'}
  extensions: starterKit,
  content: <span class="s">'&lt;p&gt;Hello.&lt;/p&gt;'</span>,
{'}'})

editor.mount(document.querySelector(<span class="s">'#editor'</span>))
editor.commands.toggleBold()<span class="c"> // typed, inferred</span></code></pre>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">Against the alternatives</p>
      <h2>An honest table.</h2>
      <div class="scroll">
        <table>
          <thead>
            <tr><th></th><th>Matra</th><th>Tiptap</th><th>Lexical</th><th>Slate</th></tr>
          </thead>
          <tbody>
            {compare.map(([row, a, b, c, d]) => (
              <tr>
                <td>{row}</td>
                <td class="mono win">{a}</td>
                <td class="mono dim">{b}</td>
                <td class="mono dim">{c}</td>
                <td class="mono dim">{d}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="foot-note">
        Where they win, and it is worth saying: ProseMirror's ecosystem is a decade deep and
        Tiptap inherits all of it, and Lexical has been hardened by Meta's traffic. If you need a
        mature extension for something exotic today, they have it and this does not.
      </p>
    </div>
  </section>

  <!-- Close -->
  <section class="section">
    <div class="wrap close">
      <h2>The core is MIT,<br />and stays that way.</h2>
      <p class="lede">
        Tables, comments, task lists, table of contents, block ids, the drag handle — free, and
        paid features elsewhere. AI and collaboration are what a subscription is for.
      </p>
      <div class="cta">
        <a class="btn" href="/docs">Get started</a>
        <a class="btn ghost" href="/pricing">Pricing</a>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    import { createEditor, starterKit } from '@matrajs/core'

    const copy = document.getElementById('copy')
    copy?.addEventListener('click', async () => {
      await navigator.clipboard?.writeText('npm i @matrajs/core')
      copy.textContent = 'copied'
      setTimeout(() => { copy.textContent = 'copy' }, 1400)
    })

    /** Measure this machine, because a table of my numbers is only a claim. */
    function measure() {
      const host = document.createElement('div')
      host.style.cssText = 'position:absolute;left:-99999px;top:0;width:800px'
      document.body.appendChild(host)

      const big = {
        type: 'doc',
        content: Array.from({ length: 2000 }, (_, i) => ({
          type: 'paragraph',
          content: [{ type: 'text', text: `Paragraph ${i} with a reasonable amount of prose.` }],
        })),
      }

      const parseStart = performance.now()
      const editor = createEditor({ extensions: starterKit, content: big as never })
      const parseMs = performance.now() - parseStart

      editor.mount(host)
      const sample = () => {
        const started = performance.now()
        for (let i = 0; i < 60; i++) {
          editor.commands.select(1 as never)
          editor.commands.insert('a')
        }
        void host.offsetHeight
        return (performance.now() - started) / 60
      }
      sample()
      const samples = [sample(), sample(), sample(), sample(), sample()].sort((a, b) => a - b)
      editor.destroy()
      host.remove()

      const set = (id: string, value: string) => {
        const node = document.getElementById(id)
        if (node) node.textContent = value
      }
      set('meter-key', `${(samples[2] as number).toFixed(2)} ms`)
      set('meter-parse', `${parseMs.toFixed(0)} ms`)
      set('meter-note', 'measured on this machine, just now')
    }

    const idle = (window as { requestIdleCallback?: (fn: () => void) => void }).requestIdleCallback
    if (idle) idle(() => measure())
    else setTimeout(measure, 800)
  </script>

  <style>
    .hero-section { border-bottom: 1px dashed var(--rule-strong); }
    .hero { padding-top: var(--s6); padding-bottom: var(--s6); max-width: 900px; }
    .hero-mark { margin-bottom: var(--s4); }
    .hero h1 { font-size: clamp(46px, 7vw, 88px); }
    .lede-wrap { margin-top: var(--s3); }
    .hero .lede { font-size: 19px; max-width: 56ch; margin: 0; }
    .hero .lede strong { color: var(--ink); font-weight: 500; }
    .cta { display: flex; gap: 12px; margin-top: var(--s4); flex-wrap: wrap; }

    .install {
      display: flex; align-items: center; justify-content: space-between; gap: 14px;
      margin-top: var(--s4); border: 1px dashed var(--rule-strong);
      background: var(--surface); padding: 14px 16px; max-width: 420px;
    }
    .install code { font-size: 14px; }
    .copy { background: none; border: 1px solid var(--rule-strong); color: var(--ink-faint); font-size: 11px; padding: 5px 10px; cursor: pointer; }
    .copy:hover { color: var(--ink); }

    .proof {
      list-style: none; margin: var(--s5) 0 0; padding: var(--s3) 0 0;
      border-top: 1px dashed var(--rule-strong);
      display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s3);
    }
    .proof li { display: flex; flex-direction: column; gap: 5px; }
    .proof b { font-family: var(--font-display); font-size: 34px; font-weight: 400; line-height: 1; }
    .proof span { font-size: 12.5px; color: var(--ink-faint); }

    .paper {
      margin-top: var(--s4); border: 1px dashed var(--rule-strong);
      background: var(--surface); padding: var(--s4);
      font-size: 16.5px;
    }
    .paper h3 { font-size: 27px; margin-bottom: var(--s2); }
    .paper p { margin: 0 0 var(--s2); }
    .paper code { font-family: var(--font-mono); font-size: 13.5px; background: var(--surface-2); padding: 1px 6px; }
    .paper ul { margin: 0 0 var(--s2); padding-left: 0; list-style: none; }
    .paper li { display: flex; gap: 10px; align-items: flex-start; }
    .paper li p { margin: 0; }
    .paper blockquote { margin: 0; padding-left: 16px; border-left: 2px solid var(--indigo); color: var(--ink-soft); }

    .meter {
      display: grid; grid-template-columns: repeat(3, 1fr);
      margin-top: var(--s4); border: 1px dashed var(--rule-strong); background: var(--surface);
    }
    .meter > div { padding: var(--s3); border-right: 1px dashed var(--rule-strong); display: flex; flex-direction: column; gap: 6px; }
    .meter > div:last-child { border-right: none; }
    .meter b { font-family: var(--font-display); font-size: 36px; font-weight: 400; line-height: 1; color: var(--indigo); }
    .meter span { font-size: 12.5px; color: var(--ink-faint); }
    .meter-note { justify-content: center; }

    .scroll { overflow-x: auto; margin-top: var(--s4); }
    td.win { color: var(--indigo); font-weight: 500; }
    td.dim { color: var(--ink-soft); }
    td.small { font-size: 13px; color: var(--ink-faint); }
    .foot-note { color: var(--ink-faint); font-size: 13.5px; max-width: 72ch; margin-top: var(--s3); }

    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: var(--s4); border-top: 1px dashed var(--rule-strong); border-left: 1px dashed var(--rule-strong); }
    .cell { padding: var(--s4); border-right: 1px dashed var(--rule-strong); border-bottom: 1px dashed var(--rule-strong); }
    .cell h3 { font-size: 23px; margin-bottom: 12px; }
    .cell p { font-size: 14.5px; color: var(--ink-soft); margin: 0 0 16px; }
    .more { font-size: 12px; color: var(--indigo); text-decoration: none; }

    .two { display: grid; grid-template-columns: 1fr 1.1fr; gap: var(--s5); align-items: center; }
    .code { border: 1px dashed var(--rule-strong); background: var(--code-bg); }
    .chrome { display: flex; align-items: center; gap: 7px; padding: 11px 15px; background: var(--code-chrome); border-bottom: 1px dashed var(--rule); }
    .chrome .d { width: 9px; height: 9px; border-radius: 50%; }
    .file { font-size: 10.5px; color: var(--code-com); margin-left: 10px; }
    .code pre { margin: 0; padding: var(--s3); overflow-x: auto; font-size: 12.5px; line-height: 1.8; color: var(--code-fg); }
    .code .k { color: var(--code-key); }
    .code .s { color: var(--code-str); }
    .code .c { color: var(--code-com); }

    .close { text-align: center; max-width: 700px; }
    .close .lede { margin-left: auto; margin-right: auto; }
    .close .cta { justify-content: center; }

    @media (max-width: 940px) {
      .grid { grid-template-columns: repeat(2, 1fr); }
      .two { grid-template-columns: 1fr; gap: var(--s4); }
      .proof { grid-template-columns: repeat(2, 1fr); }
      .meter { grid-template-columns: 1fr; }
      .meter > div { border-right: none; border-bottom: 1px dashed var(--rule-strong); }
    }
    @media (max-width: 620px) {
      .grid { grid-template-columns: 1fr; }
      .paper { padding: var(--s3); }
    }
  </style>
</Base>
