---
import {
  Cancel01Icon,
  CheckmarkSquare02Icon,
  CodeSquareIcon,
  Copy01Icon,
  Heading01Icon,
  Heading02Icon,
  Heading03Icon,
  HighlighterIcon,
  LeftToRightListBulletIcon,
  LeftToRightListNumberIcon,
  MinusSignIcon,
  QuoteDownIcon,
  Redo02Icon,
  SourceCodeIcon,
  Table01Icon,
  TextAlignCenterIcon,
  TextAlignLeftIcon,
  TextBoldIcon,
  TextItalicIcon,
  TextStrikethroughIcon,
  TextUnderlineIcon,
  Tick02Icon,
  Undo02Icon,
} from '@hugeicons/core-free-icons'
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'
import Logo from '../components/Logo.astro'
import Nav from '../components/Nav.astro'
import Toolbar from '../components/Toolbar.astro'
import Window from '../components/Window.astro'
import facts from '../data/facts.json'
import sizes from '../data/sizes.json'
import Base from '../layouts/Base.astro'

/**
 * One column width for every section, so the page has a single left edge.
 *
 * Each section answers one question and stops. The five editor sections come
 * one after another on scroll rather than behind tabs · a tab is a thing nobody
 * clicks, and the whole argument is that the same package makes all of them.
 */

/**
 * What each toolbar can do.
 *
 * Named commands rather than closures, so a button for a command the editor
 * does not have is a button that never renders · the same rule the slash menu
 * follows. `active` is what lights it, read from `editor.isActive`.
 */
const BLOCK_TOOLS = [
  { cmd: 'toggleBold', icon: TextBoldIcon, title: 'Bold', active: 'bold' },
  { cmd: 'toggleItalic', icon: TextItalicIcon, title: 'Italic', active: 'italic' },
  {
    cmd: 'toggleStrike',
    icon: TextStrikethroughIcon,
    title: 'Strikethrough',
    active: 'strike',
  },
  { cmd: 'toggleCode', icon: SourceCodeIcon, title: 'Inline code', active: 'code' },
  { cmd: 'toggleHighlight', icon: HighlighterIcon, title: 'Highlight', active: 'highlight' },
  '|',
  {
    cmd: 'toggleHeading',
    arg: 1,
    icon: Heading01Icon,
    title: 'Heading one',
    active: 'heading',
  },
  {
    cmd: 'toggleHeading',
    arg: 2,
    icon: Heading02Icon,
    title: 'Heading two',
    active: 'heading',
  },
  {
    cmd: 'toggleHeading',
    arg: 3,
    icon: Heading03Icon,
    title: 'Heading three',
    active: 'heading',
  },
  '|',
  {
    cmd: 'toggleBulletList',
    icon: LeftToRightListBulletIcon,
    title: 'Bulleted list',
    active: 'bulletList',
  },
  {
    cmd: 'toggleOrderedList',
    icon: LeftToRightListNumberIcon,
    title: 'Numbered list',
    active: 'orderedList',
  },
  {
    cmd: 'toggleTaskList',
    icon: CheckmarkSquare02Icon,
    title: 'To-do list',
    active: 'taskList',
  },
  '|',
  { cmd: 'toggleBlockquote', icon: QuoteDownIcon, title: 'Quote', active: 'blockquote' },
  { cmd: 'toggleCodeBlock', icon: CodeSquareIcon, title: 'Code block', active: 'codeBlock' },
  { cmd: 'insertHorizontalRule', icon: MinusSignIcon, title: 'Divider' },
  '|',
  { cmd: 'undo', icon: Undo02Icon, title: 'Undo' },
  { cmd: 'redo', icon: Redo02Icon, title: 'Redo' },
]

const COMMENT_TOOLS = [
  { cmd: 'toggleBold', icon: TextBoldIcon, title: 'Bold', active: 'bold' },
  { cmd: 'toggleItalic', icon: TextItalicIcon, title: 'Italic', active: 'italic' },
  { cmd: 'toggleCode', icon: SourceCodeIcon, title: 'Inline code', active: 'code' },
]

const DOC_TOOLS = [
  { cmd: 'toggleBold', icon: TextBoldIcon, title: 'Bold', active: 'bold' },
  { cmd: 'toggleItalic', icon: TextItalicIcon, title: 'Italic', active: 'italic' },
  { cmd: 'toggleUnderline', icon: TextUnderlineIcon, title: 'Underline', active: 'underline' },
  '|',
  {
    cmd: 'toggleHeading',
    arg: 2,
    icon: Heading02Icon,
    title: 'Heading two',
    active: 'heading',
  },
  {
    cmd: 'toggleHeading',
    arg: 3,
    icon: Heading03Icon,
    title: 'Heading three',
    active: 'heading',
  },
  {
    cmd: 'toggleBulletList',
    icon: LeftToRightListBulletIcon,
    title: 'Bulleted list',
    active: 'bulletList',
  },
  { cmd: 'toggleBlockquote', icon: QuoteDownIcon, title: 'Quote', active: 'blockquote' },
  '|',
  { cmd: 'setTextAlign', arg: 0, icon: TextAlignLeftIcon, title: 'Align left' },
  { cmd: 'setTextAlign', arg: 1, icon: TextAlignCenterIcon, title: 'Align centre' },
  '|',
  { cmd: 'insertTable', icon: Table01Icon, title: 'Insert a table' },
  { cmd: 'undo', icon: Undo02Icon, title: 'Undo' },
  { cmd: 'redo', icon: Redo02Icon, title: 'Redo' },
]

const MD_TOOLS = [
  { cmd: 'toggleBold', icon: TextBoldIcon, title: 'Bold', active: 'bold' },
  { cmd: 'toggleItalic', icon: TextItalicIcon, title: 'Italic', active: 'italic' },
  '|',
  {
    cmd: 'toggleHeading',
    arg: 2,
    icon: Heading02Icon,
    title: 'Heading two',
    active: 'heading',
  },
  {
    cmd: 'toggleBulletList',
    icon: LeftToRightListBulletIcon,
    title: 'Bulleted list',
    active: 'bulletList',
  },
  {
    cmd: 'toggleTaskList',
    icon: CheckmarkSquare02Icon,
    title: 'To-do list',
    active: 'taskList',
  },
  { cmd: 'toggleCodeBlock', icon: CodeSquareIcon, title: 'Code block', active: 'codeBlock' },
]

/**
 * Four editors, one browser, one run.
 *
 * Measured in Chrome 152 with all four mounted in the same page, each figure the
 * median of three runs of a median of seven samples. `null` is not a zero: it
 * is an operation that could not be measured the same way for that editor.
 *
 * Ordered biggest win first and the loss last. Reading a document in is what a
 * page does before anybody has typed; putting the row Matra loses at the bottom
 * is not hiding it — it is the last thing you see.
 *
 * Every figure here comes from one run of the harness, on one machine, on one
 * day. Two of those runs are not the same measurement: the same Lexical, with
 * no line of it changed, parsed in 34.7 ms one week and 76.9 ms the next. Only
 * the comparison inside a single run says anything, which is why all four are
 * mounted in the same page in the same pass.
 */
const RIVALS = ['Matra', 'Tiptap', 'Lexical', 'Slate']

const speed = [
  { op: 'Read a document in', size: '2,000 paragraphs', ms: [2.2, 8.1, 35.8, null] },
  { op: 'Write it back out as HTML', size: '2,000 paragraphs', ms: [0.3, 1.7, 5.3, null] },
  { op: 'One keystroke', size: '2,000 paragraphs', ms: [0.48, 0.622, 0.547, null] },
  { op: 'One keystroke', size: '200 paragraphs', ms: [0.073, 0.158, 0.102, null] },
  // `floor` is the same paragraphs built by hand, with no editor in the page at
  // all. It is not drawn here — the chart is for deciding whether to look
  // further, and a fifth bar that is not a competitor gets in the way of that.
  // It is in the table on /docs/benchmarks, where the reader is checking work
  // rather than scanning.
  {
    op: 'Put an editor on screen',
    size: '200 paragraphs',
    ms: [1.2, 4.6, 2.3, 5.0],
    floor: 1.0,
  },
  {
    op: 'Put an editor on screen',
    size: '2,000 paragraphs',
    ms: [14.6, 34.1, 21.6, 50.2],
    floor: 12.2,
  },
]

/**
 * The verdict, worked out from the numbers rather than written next to them.
 *
 * A hand-written label is a label that stops being true the next time the
 * benchmark runs. Anything inside a tenth of Matra is called level, because
 * these rows move by more than that between runs and a 4% lead is not a lead.
 */
function verdict(ms: (number | null)[]) {
  const timed = ms
    .map((value, index) => ({ value, name: RIVALS[index] as string }))
    .filter((entry): entry is { value: number; name: string } => entry.value !== null)
  const sorted = [...timed].sort((a, b) => a.value - b.value)
  const best = sorted[0] as { value: number; name: string }
  const ours = ms[0] as number

  if (best.name === 'Matra') {
    const next = sorted[1] as { value: number; name: string }
    return { text: `${(next.value / ours).toFixed(1)}× ahead`, tone: 'win' }
  }
  const ratio = ours / best.value
  if (ratio < 1.1) return { text: `level with ${best.name}`, tone: 'level' }
  return { text: `${best.name} ahead`, tone: 'behind' }
}

/** Sub-millisecond figures need their third decimal; the rest do not. */
const ms = (value: number) => (value < 1 ? value.toFixed(3) : value.toFixed(1))

/** Longest bar is the slowest thing in that row. */
const widths = (ms: (number | null)[], slowest: number) =>
  ms.map((value) => (value === null ? 0 : Math.max(2, (value / slowest) * 100)))

const chart = speed.map((row) => {
  const slowest = Math.max(...row.ms.filter((value): value is number => value !== null))
  return {
    ...row,
    verdict: verdict(row.ms),
    widths: widths(row.ms, slowest),
  }
})

/**
 * What you ship, measured the same way for all four: one app importing that
 * editor and its rich-text kit, bundled and minified with esbuild, then gzipped.
 */
/**
 * Our own number comes from `pnpm size`; the rivals are measured by hand the
 * same way, in `bench/browser`. Typing ours in was three rounds of updating
 * four places and missing one.
 */
const ourSize = sizes.rungs.find((rung) => rung.id === 'starter')?.gz ?? 0

const bundles = [
  { name: 'Matra', kb: ourSize, note: 'core and starter kit' },
  { name: 'Tiptap', kb: 119.8, note: 'with ProseMirror' },
  { name: 'Lexical', kb: 94.0, note: 'with rich-text' },
  { name: 'Slate', kb: 63.0, note: '29.0 kB without React' },
]

/** Worked out, not typed · the ratio has to follow the numbers above it. */
const heaviest = Math.max(...bundles.map((entry) => entry.kb))
const smaller = Math.round(heaviest / (bundles[0]?.kb ?? 1))

/**
 * Words that mean the same thing in every column.
 *
 * The mark is read off the value, not written next to it, so Tiptap's `none`
 * for a runtime licence check gets the same tick Matra's does. A table that
 * only awards ticks to one column is not a table, it is a poster.
 */
const GOOD = new Set(['none', 'inferred', 'built in', 'yes', 'free', 'never'])
const BAD = new Set(['paid', 'build it', 'manual', 'no', 'augmentation'])
const toneOf = (value: string) => (GOOD.has(value) ? 'good' : BAD.has(value) ? 'bad' : 'flat')

const compare = [
  ['Runtime dependencies', 'none', '51 packages', '9 packages', 'React'],
  ['Engine types in your code', 'none', 'ProseMirror', 'Lexical', 'Slate'],
  ['Command types', 'inferred', 'augmentation', 'manual', 'manual'],
  ['Async position safety', 'built in', 'manual', 'manual', 'manual'],
  ['Markdown without a DOM', 'yes', 'no', 'no', 'no'],
  ['Table of contents', 'free', 'paid', 'build it', 'build it'],
  ['Unique block ids', 'free', 'paid', 'build it', 'build it'],
  ['Drag handle', 'free', 'paid', 'build it', 'build it'],
  ['Comments', 'free', 'paid', 'build it', 'build it'],
  ['Runtime licence check', 'never', 'none', '·', '·'],
]

/**
 * Grouped as the design file groups them. The package names there were
 * invented · one per extension · and the real answer is that almost all of it
 * is in the core, which is rather the point of the heading.
 */
const groups = [
  [
    'Text',
    ['bold', 'italic', 'strike', 'code', 'underline', 'highlight', 'link', 'subscript'],
    '@matrajs/core',
  ],
  [
    'Blocks',
    ['heading', 'blockquote', 'codeBlock', 'lists', 'taskList', 'image', 'rule'],
    '@matrajs/core',
  ],
  [
    'Structure',
    ['table', 'tableOfContents', 'uniqueId', 'dragHandle', 'comments'],
    '@matrajs/core',
  ],
  [
    'Writing',
    [
      'placeholder',
      'characterCount',
      'textAlign',
      'typography',
      'markdown',
      'search',
      'autosave',
    ],
    '@matrajs/core',
  ],
  ['Templates', ['locked', 'field', 'snippets'], '@matrajs/core'],
  ['Layout', ['columns', 'pageBreak', 'embed', 'footnotes', 'math'], '@matrajs/core'],
  ['Menus', ['suggestion', 'mention', 'bubbleMenu', 'ghostText', 'dictation'], '@matrajs/core'],
  ['AI', ['streaming edits', 'position markers'], '@matrajs/ai'],
  ['Collaborate', ['authority', 'rebasing', 'remote cursors'], '@matrajs/collab'],
  ['History', ['snapshots', 'block diff', 'word diff', 'restore'], '@matrajs/versions'],
]

/** Counted, so the sentence above the row cannot drift from the row. */
const coreGroups = groups.filter(([, , pkg]) => pkg === '@matrajs/core').length
---

<Base
  title="Matra · the editor you are already using"
  description={`A headless rich text editor framework. ${ourSize} kB gzipped, zero dependencies, measured against Tiptap, Lexical and Slate in one browser. Every word on this page is running it.`}
>
  <Nav />

  <!-- 1. What it is -->
  <header class="section flush">
    <div class="wrap hero">
      <h1>The editor you are<br />already using.</h1>
      <p class="lede">
        Every word on this page is a Matra document. Select this sentence and press
        <strong>Mod-B</strong>. Start a new line and press <strong>/</strong> for the block menu.
        Type <strong>"quotes"</strong> and watch them curl. Nothing here is a screenshot and nothing
        is a video. It is the product, at the size the table further down claims.
      </p>

      <div class="cta" data-static>
        <a class="btn" href="/docs">Read the docs</a>
        <a class="btn ghost" href="#editors">See five editors</a>
      </div>

      <div class="install boxed filled" data-static>
        <code class="mono">npm i @matrajs/core</code>
        <button id="copy" class="copy mono" type="button" aria-label="Copy install command">
          <Icon icon={Copy01Icon} class="at-idle" size={13} />
          <Icon icon={Tick02Icon} class="at-done" size={13} />
          <span class="at-idle">copy</span>
          <span class="at-done">copied</span>
        </button>
      </div>

      <ul class="proof boxed-top bleed">
        <li><b>{ourSize} kB</b><span>gzipped, with the starter kit</span></li>
        <li><b>0</b><span>runtime dependencies</span></li>
        <li><b>{facts.tests}</b><span>tests, {facts.adversarial} adversarial</span></li>
        <li><b>MIT</b><span>core, permanently</span></li>
      </ul>
    </div>
  </header>

  <!-- 2. Proof that it is really running -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">What you get</p>
      <h2>Not a demo.<br />The actual editor.</h2>
      <p class="lede">
        This block has the whole extension set on. Press <code>/</code> on an empty line for the block
        menu, or start typing with <code>#</code>, <code>-</code> or <code>[]</code>
        and skip it. Mod-B, Mod-I, Mod-Z all work. Break it however you like; a reload puts it back.
      </p>

      <div class="paper boxed filled bleed" data-editable="full">
        <h3>Try it properly</h3>
        <p>
          Undo groups by what you did rather than by keystroke, so one Mod-Z takes back a whole
          word instead of one letter. Typing "smart quotes" curls them, and two hyphens --
          become an em dash.
        </p>
        <ul data-type="taskList">
          <li data-checked="true"><p>Tick this · a real node, not a glyph</p></li>
          <li data-checked="false"><p>Add a line and watch the list continue</p></li>
        </ul>
        <blockquote>
          <p>A quote, because a quote is a block and blocks are what this is made of.</p>
        </blockquote>
        <p>Empty line, then <code>/</code> — the menu only lists what this editor can do.</p>
      </div>
    </div>
  </section>

  <!-- 3–7. The same package, five shapes -->
  <section class="section" id="editors">
    <div class="wrap">
      <p class="kicker">Headless, demonstrated</p>
      <h2>One package,<br />five different editors.</h2>
      <p class="lede">
        None of these is a theme or a preset. Each is <span class="mono">createEditor</span> with
        a different array of extensions and different CSS around it. All five are live, and all five
        share one {ourSize} kB download.
      </p>
    </div>
  </section>

  <!-- 01 · the block editor -->
  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">01 · Block editor</p>
        <h3>The Notion shape.</h3>
        <p>
          Every block type, every mark, the slash menu and the markdown shortcuts. Press
          <code>/</code> on the empty line, or start one with <code>#</code>, <code>-</code>,
          <code>1.</code> or <code>[]</code>.
        </p>
        <p class="mono packages">
          starterKit · taskList · typography · suggestion · placeholder
        </p>
      </div>
      <Window name="block-editor.md" bleed="right">
        <Toolbar slot="toolbar" for="notion" tools={BLOCK_TOOLS} />
        <div id="ed-notion" class="ed-notion"></div>
      </Window>
    </div>
  </section>

  <!-- 02 · the comment box -->
  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">02 · Comment box</p>
        <h3>Three marks, deliberately.</h3>
        <p>
          Bold, italic, code, and nothing else. A comment box that can make headings is a bug
          report waiting to happen · constraining an editor is the same work as extending one.
        </p>
        <p class="mono packages">document · paragraph · text · bold · italic · code</p>
      </div>
      <Window name="comment.txt" bleed="right">
        <div slot="toolbar" class="who">
          <span class="avatar" aria-hidden="true">N</span>
          <span>Nahim commented</span>
        </div>
        <div id="ed-comment" class="ed-comment"></div>
        <Fragment slot="foot">
          <Toolbar for="comment" tools={COMMENT_TOOLS} />
          <span id="count-comment" class="mono count">0 characters</span>
          <button class="post" type="button">Post</button>
        </Fragment>
      </Window>
    </div>
  </section>

  <!-- 03 · the document -->
  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">03 · Document</p>
        <h3>A toolbar over a page.</h3>
        <p>
          Headings, quotes, alignment, tables, undo. Every button is a command call, and the
          command types come from the array of extensions rather than from a declaration.
        </p>
        <p class="mono packages">starterKit · tableKit · textAlign · typography</p>
      </div>
      <Window name="quarterly-note.doc" bleed="right">
        <Toolbar slot="toolbar" for="docs" tools={DOC_TOOLS} />
        <div id="ed-docs" class="ed-docs"></div>
      </Window>
    </div>
  </section>

  <!-- 04 · markdown -->
  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">04 · Markdown</p>
        <h3>Out, without a DOM.</h3>
        <p>
          The panel beside this is <code>toMarkdown</code> running on every keystroke. It never touches
          the DOM, so the same call runs on a server with no jsdom in sight.
        </p>
        <p class="mono packages">starterKit · taskList · toMarkdown</p>
      </div>
      <Window name="notes.md" flush bleed="right">
        <Toolbar slot="toolbar" for="markdown" tools={MD_TOOLS} />
        <div class="md-split">
          <div id="ed-markdown" class="ed-markdown"></div>
          <pre class="md-out" data-static><code id="md-output" /></pre>
        </div>
      </Window>
    </div>
  </section>

  <!-- 05 · the chat composer -->
  <section class="section">
    <div class="wrap demo-row">
      <div class="demo-copy">
        <p class="kicker">05 · Chat composer</p>
        <h3>One block, and a send key.</h3>
        <p>
          No headings, no lists, no way to paste a document into a message box. Enter sends,
          Shift-Enter breaks the line.
        </p>
        <p class="mono packages">document · paragraph · text · bold · italic · hardBreak</p>
      </div>
      <Window name="messages" flush bleed="right">
        <div class="chat-log" id="chat-log">
          <div class="bubble them">Did the drag handle land?</div>
          <div class="bubble me">It did · and it is free, which Tiptap's is not.</div>
        </div>
        <Fragment slot="foot">
          <div id="ed-chat" class="ed-chat"></div>
          <button class="send" id="chat-send" type="button" aria-label="Send">↑</button>
        </Fragment>
      </Window>
    </div>
  </section>

  <!-- 8. Is it fast -->
  <section class="section" id="speed">
    <div class="wrap">
      <p class="kicker">Measured, not claimed</p>
      <h2>Faster where it is felt.</h2>
      <p class="lede">Four editors, one browser, one run. Shorter is faster.</p>

      <div class="meter bleed">
        <div><b id="meter-key">measuring…</b><span>per keystroke, 2,000 paragraphs</span></div>
        <div><b id="meter-parse">·</b><span>to read that document in</span></div>
        <div><b id="meter-html">·</b><span>to write it back out</span></div>
      </div>
      <p class="meter-note mono" id="meter-note">running in your browser…</p>

      <!--
        Static on purpose. Every bar carries its number inside a fixed grid, and
        an editor over the top of that flattens the three columns onto one line
        · the same reason the proof list in the hero is left alone.
      -->
      <div class="chart bleed" data-static>
        {
          chart.map((row) => (
            <div class="chart-row">
              <div class="chart-head">
                <span class="chart-op">{row.op}</span>
                <span class="chart-size mono">{row.size}</span>
                <span class={`chart-chip ${row.verdict.tone}`}>{row.verdict.text}</span>
              </div>

              {RIVALS.map((name, index) => (
                <div class={`chart-line${index === 0 ? ' ours' : ''}`}>
                  <span class="chart-who mono">{name}</span>
                  <div class="chart-track">
                    {row.ms[index] === null ? (
                      <span class="chart-blank mono">not measured</span>
                    ) : (
                      <div class="chart-bar" style={`--w: ${row.widths[index]}%`} />
                    )}
                  </div>
                  <span class="chart-ms mono">
                    {row.ms[index] === null ? '—' : `${ms(row.ms[index] as number)} ms`}
                  </span>
                </div>
              ))}
            </div>
          ))
        }
      </div>

      <p class="foot-note">
        Slate's keystroke is blank because the harness would not print it: nothing had reached
        the screen when the timer stopped.
        <a href="/docs/benchmarks">Method, caveats and how to run it yourself →</a>
      </p>
    </div>
  </section>

  <!-- 9. What you get -->
  <section class="section">
    <div class="wrap">
      <div class="ext-head">
        <div>
          <p class="kicker">Extensions</p>
          <h2>A small core.<br />Everything else hangs off it.</h2>
        </div>
        <p class="ext-note">
          Nodes, marks and behaviour are all the same shape: a plain object with a name.
          {coreGroups} of these {groups.length} groups are in the core and MIT, including four that
          are paid features elsewhere.
        </p>
      </div>

      <!--
        The layout is the mark. In Bengali the matra is the line letters hang
        from, so the groups hang off one rule on stems of different lengths —
        the same three-stem shape as the logo, widened to seven.
      -->
      <div class="matra-line" aria-hidden="true"></div>
      <div class="hanging" style={`--columns: ${groups.length}`}>
        {
          groups.map(([name, items, pkg], index) => (
            <article class="hang" style={`--stem: ${28 + index * 16}px`}>
              <span class="stem" aria-hidden="true" />
              <div class="hang-body">
                <div class="hang-name">{name}</div>
                <div class="hang-pkg mono">{pkg}</div>
                <ul class="hang-items">
                  {(items as string[]).map((item) => (
                    <li class="mono">{item}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
