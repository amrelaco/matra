---
import Docs from '../../layouts/Docs.astro'

/** Taken from the extensions themselves, not from memory. */
const groups = [
  [
    'Marks',
    [
      ['Mod-B', 'Bold'],
      ['Mod-I', 'Italic'],
      ['Mod-U', 'Underline'],
      ['Mod-E', 'Inline code'],
      ['Mod-Shift-X', 'Strikethrough'],
      ['Mod-Shift-H', 'Highlight'],
    ],
  ],
  [
    'Blocks',
    [
      ['Mod-Alt-1 … 6', 'Heading, levels one to six'],
      ['Mod-Alt-0', 'Back to a paragraph'],
      ['Mod-Shift-B', 'Blockquote'],
      ['Mod-Alt-C', 'Code block'],
    ],
  ],
  [
    'Lists',
    [
      ['Mod-Shift-8', 'Bulleted list'],
      ['Mod-Shift-9', 'Ordered list'],
      ['Mod-Shift-7', 'Task list'],
      ['Mod-Enter', 'Tick or untick a task'],
      ['Tab', 'Indent the list item'],
      ['Shift-Tab', 'Outdent it'],
      ['Enter', 'Split the item'],
    ],
  ],
  [
    'Editing',
    [
      ['Mod-Z', 'Undo'],
      ['Mod-Shift-Z', 'Redo'],
      ['Mod-Y', 'Redo, for Windows hands'],
      ['Shift-Enter', 'Line break inside a block'],
    ],
  ],
]

const rules = [
  ['# ', 'Heading one. Two hashes for a level two, and so on to six.'],
  ['- ', 'Bulleted list. A plus or an asterisk works too.'],
  ['1. ', 'Ordered list, starting at that number.'],
  ['[] ', 'Task list. Use [x] for one already done.'],
  ['"', 'Curls, and knows which way — typography extension.'],
  ["don't", 'The apostrophe closes rather than opens.'],
  ['-- ', 'An em dash.'],
  ['... ', 'An ellipsis.'],
  ['-> ', 'An arrow. Also <-, (c), (tm), +/-.'],
]
---
<Docs title="Keyboard shortcuts — Matra docs" description="Every shortcut and input rule the starter kit binds." section="Reference" heading="Keyboard shortcuts">
  <p>
    <code>Mod</code> is Command on a Mac and Control everywhere else — you bind it once and it
    is right on both.
  </p>

  {groups.map(([name, rows]) => (
    <>
      <h2>{name}</h2>
      <div class="keys">
        {rows.map(([key, what]) => (
          <div class="row">
            <kbd>{key}</kbd>
            <span>{what}</span>
          </div>
        ))}
      </div>
    </>
  ))}

  <h2>Input rules</h2>
  <p>Typed rather than pressed. Each one is a single undo step, so a wrong guess costs one Mod-Z.</p>
  <div class="keys">
    {rules.map(([typed, what]) => (
      <div class="row">
        <kbd class="typed">{typed}</kbd>
        <span>{what}</span>
      </div>
    ))}
  </div>

  <h2>Binding your own</h2>
  <pre><code>const spoiler: MarkDef&lt;&#123; toggleSpoiler: Command &#125;&gt; = &#123;
  kind: 'mark',
  name: 'spoiler',
  commands: &#123; toggleSpoiler: (ctx) =&gt; ctx.toggleMark('spoiler') &#125;,
  keys: &#123; 'Mod-Shift-S': 'toggleSpoiler' &#125;,
&#125;</code></pre>
  <p>
    A key can name a command or be a function. Later extensions win a conflict, so ordering the
    array is how you override a built-in binding.
  </p>

  <style>
    .keys { display: grid; grid-template-columns: 1fr 1fr; gap: 0 26px; margin: 0 0 18px; }
    .row { display: flex; align-items: baseline; gap: 12px; padding: 7px 0; border-bottom: 1px dashed var(--rule); }
    kbd { font-family: var(--font-mono); font-size: 11.5px; border: 1px solid var(--rule-strong); background: var(--surface-2); padding: 3px 7px; white-space: nowrap; flex: none; min-width: 108px; text-align: center; }
    kbd.typed { color: var(--indigo); }
    .row span { font-size: 13.5px; color: var(--ink-soft); }
    @media (max-width: 720px) { .keys { grid-template-columns: 1fr; } }
  </style>
</Docs>
