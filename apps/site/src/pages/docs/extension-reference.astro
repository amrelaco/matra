---
import Code from '../../components/Code.astro'
import api from '../../data/extensions-api.json'
import Docs from '../../layouts/Docs.astro'

/**
 * The index of the extension reference.
 *
 * This page was once all eighty-one entries in one scroll, which reads well to a
 * crawler and badly to a person looking for one of them. The entries now have a
 * page each and this lists them; the single-document form still exists, because
 * `scripts/extension-api.mjs` writes it as Markdown for `llms-full.txt` and the
 * MCP server, where one fetch containing everything is the point.
 */
const { extensions, kits, counts } = api

const KINDS = [
  ['node', 'Nodes', 'Blocks and inline elements the document is made of.'],
  ['mark', 'Marks', 'Formatting applied across a range of text.'],
  [
    'extension',
    'Behaviour',
    'No node or mark of their own · they add commands, keys or decorations.',
  ],
] as const

const byKind = KINDS.map(([kind, title, blurb]) => ({
  title,
  blurb,
  items: extensions.filter((e) => e.kind === kind),
}))

/** The first sentence, or a fact about the definition when there is no prose. */
const summary = (e: (typeof extensions)[number]) => {
  const first = e.doc.find((block) => block.type === 'text')
  if (first) return first.text
  const bits: string[] = []
  if (e.dom.parses.length) bits.push(`parses ${e.dom.parses.join(', ')}`)
  if (e.dom.renders) bits.push(`renders ${e.dom.renders}`)
  return bits.join(' · ')
}
---

<Docs
  title="Every extension | Matra docs"
  description={`Reference for all ${counts.extensions} extensions in @matrajs/core: what to import, the options each takes, its commands, keyboard shortcuts and gzipped cost.`}
  section="Reference"
  heading="Every extension"
>
  <p>
    All {counts.extensions} of them live in <code>@matrajs/core</code> and carry {
      counts.commands
    } commands between them. Each has its own page below, and they are in the sidebar too.
  </p>

  <h2>Installing only what you want</h2>
  <p>
    There is no <code>@matrajs/table</code> to install · you already have the table, and you turn
    it on by importing it. That is the difference from an editor where every extension is its own
    package.
  </p>
  <Code code={`npm install @matrajs/core`} lang="sh" />
  <p>Then pass only the extensions you want. A table and nothing else:</p>
  <Code
    code={`import { createEditor, document, paragraph, text, tableKit } from '@matrajs/core'

const editor = createEditor({
  extensions: [document, paragraph, text, ...tableKit],
  element: document.querySelector('#editor'),
})`}
    lang="ts"
  />
  <div class="note">
    <p>
      <code>document</code>, <code>paragraph</code> and <code>text</code> are the floor. Every document
      is a <code>document</code> holding blocks, and a table cell holds blocks, so a table without
      them has nothing legal to contain.
    </p>
  </div>
  <p>
    The array is the whole feature list, and it is also the bundle. Extensions you do not import
    are not in the build · that is ordinary tree-shaking, not a plugin system, which is why the
    gzipped figures add rather than multiply.
  </p>

  <h2>Kits</h2>
  <p>
    A kit is an array of definitions, spread with <code>...</code>. Nothing more · there is no
    configuration object and no ordering rule.
  </p>
  <div class="scroll">
    <table class="ref">
      <thead>
        <tr><th>Kit</th><th>Holds</th></tr>
      </thead>
      <tbody>
        {
          kits.map((kit) => (
            <tr>
              <td>
                <code>{kit.name}</code>
              </td>
              <td class="members">
                {kit.members.map((m) => (
                  <a href={`/docs/extension-reference/${m}`}>
                    <code>{m}</code>
                  </a>
                ))}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    byKind.map((group) => (
      <>
        <h2>
          {group.title} <span class="count">{group.items.length}</span>
        </h2>
        <p>{group.blurb}</p>
        <ul class="cards">
          {group.items.map((e) => (
            <li>
              <a href={`/docs/extension-reference/${e.importName}`}>
                <code>{e.importName}</code>
                {e.gz != null && <span class="gz">{e.gz} kB</span>}
              </a>
              <span class="what">{summary(e)}</span>
            </li>
          ))}
        </ul>
      </>
    ))
  }

  <p class="stamp">
    Generated from <code>@matrajs/core</code> by <code>node scripts/extension-api.mjs</code>.
    The whole reference as one document, for tools that would rather fetch once, is at <a
      href="/llms-full.txt">llms-full.txt</a
    >.
  </p>

  <style>
    .scroll {
      overflow-x: auto;
      margin-top: var(--s3);
    }

    .ref {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    .ref th,
    .ref td {
      padding: 9px 14px 9px 0;
      text-align: left;
      vertical-align: top;
      background-image: var(--dash-h);
      background-size: 100% 1px;
      background-position: 0 100%;
      background-repeat: no-repeat;
    }

    .ref th {
      font-weight: 500;
      color: var(--ink-faint);
      font-size: 12.5px;
    }

    .members a {
      margin: 0 6px 4px 0;
      display: inline-block;
    }

    .count {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--ink-faint);
      font-weight: 400;
    }

    /* Two columns of names, each with the one line that says what it is. */
    .cards {
      list-style: none;
      padding: 0;
      margin: var(--s3) 0 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2px 28px;
    }

    .cards li {
      padding: 9px 0;
      background-image: var(--dash-h);
      background-size: 100% 1px;
      background-position: 0 100%;
      background-repeat: no-repeat;
    }

    .cards a {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
    }

    .gz {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--ink-faint);
      white-space: nowrap;
    }

    .what {
      display: block;
      font-size: 13px;
      line-height: 1.55;
      color: var(--ink-faint);
      margin-top: 2px;
    }

    .stamp {
      margin-top: var(--s4);
      font-size: 13px;
      color: var(--ink-faint);
    }

    @media (max-width: 860px) {
      .cards {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
</Docs>
