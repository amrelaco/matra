---
import {
  CheckmarkSquare02Icon,
  CodeSquareIcon,
  Copy01Icon,
  Heading01Icon,
  Heading02Icon,
  HighlighterIcon,
  LeftToRightListBulletIcon,
  LeftToRightListNumberIcon,
  MinusSignIcon,
  QuoteDownIcon,
  Redo02Icon,
  SourceCodeIcon,
  Table01Icon,
  TextAlignCenterIcon,
  TextAlignLeftIcon,
  TextBoldIcon,
  TextItalicIcon,
  TextStrikethroughIcon,
  TextUnderlineIcon,
  Tick02Icon,
  Undo02Icon,
} from '@hugeicons/core-free-icons'
import Footer from '../components/Footer.astro'
import Head from '../components/Head.astro'
import Icon from '../components/Icon.astro'
import Nav from '../components/Nav.astro'
import Toolbar from '../components/Toolbar.astro'
import Window from '../components/Window.astro'
import sizes from '../data/sizes.json'
import Base from '../layouts/Base.astro'

/**
 * The directory, shown rather than listed.
 *
 * A table of twenty-two rows tells you the names of things you have never used.
 * Each group here gets a live editor with those extensions in it and nothing
 * else, so "task lists" is a checkbox you can tick rather than a line of prose
 * claiming there is one.
 *
 * Every extension named ships. A directory advertising installs that 404 is
 * worse than no directory.
 */
const groups = [
  {
    id: 'marks',
    kicker: 'Marks',
    title: 'The everyday six.',
    blurb:
      'Bold, italic, strike, code, underline, highlight. Each is a plain object with a command, a key and a tag — and yours would be the same shape.',
    items: ['bold', 'italic', 'strike', 'code', 'underline', 'highlight', 'link'],
    tools: [
      { cmd: 'toggleBold', icon: TextBoldIcon, title: 'Bold', active: 'bold' },
      { cmd: 'toggleItalic', icon: TextItalicIcon, title: 'Italic', active: 'italic' },
      {
        cmd: 'toggleStrike',
        icon: TextStrikethroughIcon,
        title: 'Strikethrough',
        active: 'strike',
      },
      { cmd: 'toggleCode', icon: SourceCodeIcon, title: 'Inline code', active: 'code' },
      {
        cmd: 'toggleUnderline',
        icon: TextUnderlineIcon,
        title: 'Underline',
        active: 'underline',
      },
      {
        cmd: 'toggleHighlight',
        icon: HighlighterIcon,
        title: 'Highlight',
        active: 'highlight',
      },
    ],
  },
  {
    id: 'blocks',
    kicker: 'Blocks',
    title: 'Headings, quotes, fences.',
    blurb:
      'Every block type carries its own markdown shortcut. Start a line with # or > or ``` and the input rule does the rest — no menu required.',
    items: ['heading', 'blockquote', 'codeBlock', 'horizontalRule', 'paragraph'],
    tools: [
      {
        cmd: 'toggleHeading',
        arg: 1,
        icon: Heading01Icon,
        title: 'Heading one',
        active: 'heading',
      },
      {
        cmd: 'toggleHeading',
        arg: 2,
        icon: Heading02Icon,
        title: 'Heading two',
        active: 'heading',
      },
      { cmd: 'toggleBlockquote', icon: QuoteDownIcon, title: 'Quote', active: 'blockquote' },
      {
        cmd: 'toggleCodeBlock',
        icon: CodeSquareIcon,
        title: 'Code block',
        active: 'codeBlock',
      },
      { cmd: 'insertHorizontalRule', icon: MinusSignIcon, title: 'Divider' },
    ],
  },
  {
    id: 'lists',
    kicker: 'Lists',
    title: 'Including the one with boxes.',
    blurb:
      'Tab nests, Shift-Tab lifts back out, Enter on an empty item leaves the list. The checkbox is a real input the caret cannot get inside — tick one.',
    items: ['bulletList', 'orderedList', 'listItem', 'taskList', 'taskItem'],
    tools: [
      {
        cmd: 'toggleBulletList',
        icon: LeftToRightListBulletIcon,
        title: 'Bulleted list',
        active: 'bulletList',
      },
      {
        cmd: 'toggleOrderedList',
        icon: LeftToRightListNumberIcon,
        title: 'Numbered list',
        active: 'orderedList',
      },
      {
        cmd: 'toggleTaskList',
        icon: CheckmarkSquare02Icon,
        title: 'To-do list',
        active: 'taskList',
      },
    ],
  },
  {
    id: 'tables',
    kicker: 'Tables',
    title: 'Rows, columns, and a caret.',
    blurb:
      'Insert one and type into it. Header rows, colspan and column widths survive a round trip through JSON and back.',
    items: ['table', 'tableRow', 'tableCell', 'tableHeader', 'image'],
    tools: [
      { cmd: 'insertTable', icon: Table01Icon, title: 'Insert a table' },
      { cmd: 'toggleBold', icon: TextBoldIcon, title: 'Bold', active: 'bold' },
      { cmd: 'undo', icon: Undo02Icon, title: 'Undo' },
    ],
  },
  {
    id: 'writing',
    kicker: 'Writing aids',
    title: 'The ones you never press.',
    blurb:
      'Type "quotes" and they curl the right way round. Two hyphens become an em dash, three dots an ellipsis, -> an arrow. Undo groups by word, not by keystroke.',
    items: ['typography', 'placeholder', 'characterCount', 'history', 'textAlign'],
    tools: [
      { cmd: 'undo', icon: Undo02Icon, title: 'Undo' },
      { cmd: 'redo', icon: Redo02Icon, title: 'Redo' },
      { cmd: 'setTextAlign', arg: 0, icon: TextAlignLeftIcon, title: 'Align left' },
      { cmd: 'setTextAlign', arg: 1, icon: TextAlignCenterIcon, title: 'Align centre' },
    ],
  },
]

/** Not shown as an editor, because neither is a thing you can try alone. */
const paid = [
  {
    name: 'AI',
    pkg: '@matrajs/ai',
    what: 'Streaming edits that survive concurrent typing. A stream that arrives while somebody is still typing lands where it was meant to, because the positions are mapped rather than remembered.',
    items: ['streamingEdit', 'positionMarkers', 'diffPreview'],
  },
  {
    name: 'Collaboration',
    pkg: '@matrajs/collab',
    what: 'An authority, step rebasing and remote cursors. Two people editing the same paragraph converge on the same document rather than on the last write.',
    items: ['authority', 'rebasing', 'remoteCursors'],
  },
  {
    name: 'Version history',
    pkg: '@matrajs/versions',
    what: 'Snapshots, a real diff between them, and restore as one undo step. Blocks are paired on their content, so a paragraph that moved is the same paragraph rather than a deletion and an insertion at two unrelated places.',
    items: ['snapshots', 'blockDiff', 'wordDiff', 'restore'],
  },
]

/**
 * Every extension, one row each.
 *
 * The five editors above show what a group feels like; this is the reference
 * you come back to. `use` is the line you would actually write, `key` is what
 * it is bound to, and `typed` is the markdown shortcut that reaches it without
 * a menu — read off the extensions rather than invented, so a shortcut printed
 * here is one the editor really has.
 */
const directory: {
  group: string
  pkg: string
  note: string
  /** Functions rather than extensions · listed here, not counted as one. */
  helpers?: boolean
  items: { name: string; what: string; use: string; key?: string; typed?: string }[]
}[] = [
  {
    group: 'Marks',
    pkg: '@matrajs/core',
    note: 'Inline formatting. Each one is a command, a key and a tag.',
    items: [
      { name: 'bold', what: 'Bold', use: 'editor.commands.toggleBold()', key: 'Mod-B' },
      { name: 'italic', what: 'Italic', use: 'editor.commands.toggleItalic()', key: 'Mod-I' },
      {
        name: 'strike',
        what: 'Struck through',
        use: 'editor.commands.toggleStrike()',
        key: 'Mod-Shift-X',
      },
      { name: 'code', what: 'Inline code', use: 'editor.commands.toggleCode()', key: 'Mod-E' },
      {
        name: 'underline',
        what: 'Underlined',
        use: 'editor.commands.toggleUnderline()',
        key: 'Mod-U',
      },
      {
        name: 'highlight',
        what: 'Highlighted, with a colour attribute',
        use: "editor.commands.toggleHighlight({ color: 'yellow' })",
        key: 'Mod-Shift-H',
      },
      {
        name: 'link',
        what: 'A link, with the scheme checked before it reaches the DOM',
        use: "editor.commands.setLink('https://matrajs.com')",
      },
      { name: 'subscript', what: 'Subscript', use: 'editor.commands.toggleSubscript()' },
      {
        name: 'superscript',
        what: 'Superscript',
        use: 'editor.commands.toggleSuperscript()',
      },
      {
        name: 'comment',
        what: 'A thread anchored to a range, which survives edits around it',
        use: "editor.commands.toggleComment({ id: 'thread-1' })",
      },
    ],
  },
  {
    group: 'Blocks',
    pkg: '@matrajs/core',
    note: 'Block types. Every one carries its own markdown shortcut.',
    items: [
      {
        name: 'document',
        what: 'The root node. Every schema needs one',
        use: 'extensions: [document, paragraph, text]',
      },
      { name: 'paragraph', what: 'The default block', use: 'editor.commands.setParagraph()' },
      { name: 'text', what: 'The text node itself', use: 'extensions: [text]' },
      {
        name: 'heading',
        what: 'Levels one to six',
        use: 'editor.commands.toggleHeading(2)',
        key: 'Mod-Alt-1 … 6',
        typed: '## ',
      },
      {
        name: 'blockquote',
        what: 'A quote, which holds blocks rather than text',
        use: 'editor.commands.toggleBlockquote()',
        key: 'Mod-Shift-B',
        typed: '> ',
      },
      {
        name: 'codeBlock',
        what: 'A fenced block that takes no marks',
        use: 'editor.commands.toggleCodeBlock()',
        key: 'Mod-Alt-C',
        typed: '``` ',
      },
      {
        name: 'horizontalRule',
        what: 'A divider · one position, no insides',
        use: 'editor.commands.insertHorizontalRule()',
        typed: '--- ',
      },
      {
        name: 'hardBreak',
        what: 'A line break inside a block',
        use: 'editor.commands.insertHardBreak()',
        key: 'Shift-Enter',
      },
      {
        name: 'image',
        what: 'An image, with the src checked like a link',
        use: "editor.commands.insertImage({ src: '/cat.png' })",
      },
    ],
  },
  {
    group: 'Lists',
    pkg: '@matrajs/core',
    note: 'Tab nests, Shift-Tab lifts, Enter on an empty item leaves the list.',
    items: [
      {
        name: 'bulletList',
        what: 'Bulleted',
        use: 'editor.commands.toggleBulletList()',
        key: 'Mod-Shift-8',
        typed: '- ',
      },
      {
        name: 'orderedList',
        what: 'Numbered',
        use: 'editor.commands.toggleOrderedList()',
        key: 'Mod-Shift-9',
        typed: '1. ',
      },
      { name: 'listItem', what: 'What a list holds', use: 'extensions: [listItem]' },
      {
        name: 'taskList',
        what: 'Checkboxes',
        use: 'editor.commands.toggleTaskList()',
        key: 'Mod-Shift-7',
        typed: '[] ',
      },
      {
        name: 'taskItem',
        what: 'One checkbox · a real input the caret cannot enter',
        use: 'editor.commands.toggleTaskItem()',
        key: 'Mod-Enter',
      },
    ],
  },
  {
    group: 'Structure',
    pkg: '@matrajs/core',
    note: 'The four that other editors put behind a paywall, and tables.',
    items: [
      {
        name: 'table',
        what: 'Rows, columns, header cells and column widths',
        use: 'editor.commands.insertTable({ rows: 3, cols: 3 })',
      },
      { name: 'tableRow', what: 'One row', use: 'editor.commands.addRowAfter()' },
      {
        name: 'tableCell',
        what: 'One cell, which holds blocks',
        use: 'editor.commands.mergeCells()',
      },
      { name: 'tableHeader', what: 'A header cell', use: 'editor.commands.toggleHeaderRow()' },
      {
        name: 'tableOfContents',
        what: 'Headings, with their level and position',
        use: "editor.extensionState('tableOfContents')",
      },
      {
        name: 'uniqueId',
        what: 'A stable id on every block, for comments and anchors',
        use: "uniqueId({ types: ['paragraph', 'heading'] })",
      },
      {
        name: 'dragHandle',
        what: 'Drag a block to reorder it',
        use: 'editor.commands.moveBlock(from, to)',
      },
    ],
  },
  {
    group: 'Writing',
    pkg: '@matrajs/core',
    note: 'The ones you never press. They work while you type.',
    items: [
      {
        name: 'placeholder',
        what: 'Text in an empty block',
        use: "placeholder({ text: 'Write something…' })",
      },
      {
        name: 'characterCount',
        what: 'Characters and words, reduced on every change',
        use: 'characterCount({ limit: 280 })',
      },
      {
        name: 'textAlign',
        what: 'Left, centre, right on a block',
        use: "editor.commands.setTextAlign('center')",
      },
      {
        name: 'typography',
        what: 'Curled quotes, em dashes, ellipses, arrows',
        use: 'extensions: [typography]',
        typed: '-- ',
      },
      {
        name: 'history',
        what: 'Undo that groups by word, not by keystroke',
        use: 'editor.commands.undo()',
        key: 'Mod-Z',
      },
    ],
  },
  {
    group: 'Menus',
    pkg: '@matrajs/core',
    note: 'Something watching what you type, and offering.',
    items: [
      {
        name: 'suggestion',
        what: 'The machinery behind a slash menu or an @ mention',
        use: "suggestion({ char: '/', name: 'slash' })",
        typed: '/',
      },
      {
        name: 'mention',
        what: 'A mention node · one position, its own DOM',
        use: "editor.commands.insertMention({ id: 'nahim' })",
        typed: '@',
      },
    ],
  },
  {
    group: 'Helpers',
    pkg: '@matrajs/core',
    helpers: true,
    note: 'Functions rather than extensions · nothing to add to the array.',
    items: [
      {
        name: 'toMarkdown',
        what: 'A document to markdown, without touching a DOM',
        use: 'toMarkdown(editor.getJSON())',
      },
      {
        name: 'fromMarkdown',
        what: 'And back again',
        use: "editor.setContent(fromMarkdown('# Hello'))",
      },
      {
        name: 'commentRanges',
        what: 'Every thread in a document, with the range it still covers',
        use: 'commentRanges(editor.getJSON())',
      },
      {
        name: 'createEditor',
        what: 'The editor itself',
        use: 'createEditor({ extensions: [...] })',
      },
    ],
  },
  {
    group: 'AI',
    pkg: '@matrajs/ai',
    note: 'Paid. Streaming edits that survive concurrent typing.',
    items: [
      {
        name: 'ai',
        what: 'A streaming rewrite that lands where it was meant to',
        use: "editor.commands.askAi('make this shorter')",
      },
    ],
  },
  {
    group: 'Collaboration',
    pkg: '@matrajs/collab',
    note: 'Paid. An authority, step rebasing and remote cursors.',
    items: [
      {
        name: 'collab',
        what: 'Rebase local work over what arrived first',
        use: "collab({ clientId: 'a1' })",
      },
      {
        name: 'remoteCursors',
        what: 'Other people’s carets, mapped through your edits',
        use: 'remoteCursors({ presence })',
      },
    ],
  },
  {
    group: 'Version history',
    pkg: '@matrajs/versions',
    note: 'Paid. Snapshots, a real diff between them, and restore.',
    items: [
      {
        name: 'versions',
        what: 'Snapshot, preview a diff, restore in one undo step',
        use: 'editor.commands.snapshotVersion()',
      },
      {
        name: 'diffDocs',
        what: 'The diff on its own · works on any two documents',
        use: 'diffDocs(before, after)',
      },
    ],
  },
]

/**
 * One count, from one place.
 *
 * The strip at the top of the page used to sum the five demo groups while the
 * directory summed itself, so the same page said 27 and 39 about the same
 * thing. The directory is the complete list, so every number on this page is
 * read off it.
 */
const inPackage = (pkg: string) =>
  directory
    .filter((group) => group.pkg === pkg && !group.helpers)
    .reduce((total, group) => total + group.items.length, 0)

const directoryCount = directory
  .filter((group) => !group.helpers)
  .reduce((total, group) => total + group.items.length, 0)
const freeCount = inPackage('@matrajs/core')
const paidPackages = [...new Set(directory.map((group) => group.pkg))].filter(
  (pkg) => pkg !== '@matrajs/core',
)

/**
 * The import line for one extension, built here rather than in the markup.
 *
 * A template literal containing a literal `{` inside an Astro expression is
 * where the compiler stops counting braces and starts guessing.
 */
const importLine = (name: string, pkg: string) => `import { ${name} } from '${pkg}'`

/**
 * The size ladder, and the arithmetic the prose beside it quotes.
 *
 * Every one of these is derived. A sentence with a number typed into it is a
 * sentence that stops being true the next time the bundle moves.
 */
const widest = Math.max(sizes.tiptap.minimum, ...sizes.rungs.map((rung) => rung.gz))
const engineGz = sizes.rungs.find((rung) => rung.id === 'engine')?.gz ?? 0
const twoMarksGz = sizes.rungs.find((rung) => rung.id === 'two-marks')?.gz ?? 0
const starterGz = sizes.rungs.find((rung) => rung.id === 'starter')?.gz ?? 0
/** Nine extensions between the two-mark editor and the starter kit. */
const perExtension = ((starterGz - twoMarksGz) / 9).toFixed(2)
const tiptapRatio = (sizes.tiptap.minimum / starterGz).toFixed(1)

/** Small numbers read better as words, and the heading is prose. */
const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six']
const spell = (n: number) => WORDS[n] ?? String(n)
---

<Base
  title="Extensions · Matra"
  description="Every extension that ships with Matra, each shown in a live editor rather than listed in a table."
>
  <Nav />
  <Head
    kicker="In the box"
    title="Everything hanging<br />off the core."
    lede="Nodes, marks and behaviour are the same shape: a plain object with a name. Each group below is a real editor with those extensions in it and nothing else."
  />

  <section class="section">
    <div class="wrap">
      <div class="counts fills bleed" data-static>
        <div><b>{freeCount}</b><span>extensions, MIT</span></div>
        <div><b>{paidPackages.length}</b><span>paid packages</span></div>
        <div><b>4</b><span>that other editors charge for</span></div>
      </div>
    </div>
  </section>

  {
    groups.map((group) => (
      <section class="section">
        <div class="wrap ext-row">
          <div class="ext-copy">
            <p class="kicker">{group.kicker}</p>
            <h3>{group.title}</h3>
            <p>{group.blurb}</p>
            <ul class="chips" data-static>
              {group.items.map((item) => (
                <li class="mono">{item}</li>
              ))}
            </ul>

            {/*
            How you actually get these. There is no per-extension install: they
            all ship in the one package, and the honest answer to "how do I add
            highlight" is the import line, not an npm command that does not
            exist.

            A JSX comment rather than an HTML one because this sits inside a
            .map() expression: Astro's compiler takes either, and the parser
            the formatter uses only takes this one.
          */}
            <div class="grab" data-static>
              <code class="mono">{`import { ${group.items.join(', ')} } from '@matrajs/core'`}</code>
              <button
                type="button"
                class="grab-copy mono"
                data-copy={`import { ${group.items.join(', ')} } from '@matrajs/core'`}
                aria-label={`Copy the import for ${group.kicker.toLowerCase()}`}
              >
                <Icon icon={Copy01Icon} class="at-idle" size={13} />
                <Icon icon={Tick02Icon} class="at-done" size={13} />
                <span class="at-idle">copy</span>
                <span class="at-done">copied</span>
              </button>
            </div>
          </div>
          <Window name={`${group.id}.md`} bleed="right">
            <Toolbar slot="toolbar" for={group.id} tools={group.tools} />
            <div id={`ed-${group.id}`} class="ext-editor" />
          </Window>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="wrap">
      <p class="kicker">Paid</p>
      <!-- Counted, not typed · the heading has to follow the list under it. -->
      <h2>{spell(paidPackages.length)} packages, one subscription.</h2>
      <p class="lede">
        None of these is a button you can press on a page, so none of them is drawn as one. The
        core stays MIT whatever happens to them.
      </p>

      <!--
        One band of three, not three cards in a grid built for two.
        The third card used to sit alone on a second row beside a hole, which
        is what a grid does when the count and the columns disagree.
      -->
      <div class="paid fills bleed" data-static>
        {
          paid.map((item, index) => (
            <div class="paid-card">
              <p class="paid-no mono">{String(index + 1).padStart(2, '0')}</p>
              <b>{item.name}</b>
              <code class="paid-pkg mono">npm i {item.pkg}</code>
              <p>{item.what}</p>
              <ul class="chips" data-static>
                {item.items.map((thing) => (
                  <li class="mono">{thing}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="foot-note">
        Table of contents, unique block ids, drag handle and comments are the four that other
        editors put behind a paywall. They are in the core here, and they stay there. What is
        paid is the work that is genuinely hard: streaming into a document somebody else is
        typing in, converging two of them, and answering what changed between two drafts.
      </p>
    </div>
  </section>

  <!--
    What a smaller array actually costs.
    Generated by `pnpm size` into sizes.json, so the ladder on the page is the
    ladder esbuild produced rather than one somebody typed once.
  -->
  <section class="section" id="size">
    <div class="wrap">
      <p class="kicker">What you ship</p>
      <h2>Take five, take everything.</h2>
      <p class="lede">
        Every extension you leave out really does leave the bundle. It is also worth knowing how
        little that saves: the engine is the floor and the extensions are rounding.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="ladder fills bleed" data-static>
        {
          sizes.rungs.map((rung) => (
            <div class="rung">
              <div class="rung-what">
                <b>{rung.label}</b>
                <span class="mono">{rung.note}</span>
              </div>
              <div class="rung-track">
                <div class="rung-bar" style={`--w: ${(rung.gz / widest) * 100}%`} />
              </div>
              <span class="rung-kb mono">{rung.gz.toFixed(1)} kB</span>
            </div>
          ))
        }
        <div class="rung rival">
          <div class="rung-what">
            <b>Tiptap, bold and underline only</b>
            <span class="mono">their per-package way, same bundler</span>
          </div>
          <div class="rung-track">
            <div class="rung-bar" style={`--w: ${(sizes.tiptap.minimum / widest) * 100}%`}>
            </div>
          </div>
          <span class="rung-kb mono">{sizes.tiptap.minimum.toFixed(1)} kB</span>
        </div>
      </div>

      <p class="foot-note">
        Gzipped, bundled with esbuild, measured by <code>pnpm size</code>. Dropping from the
        starter kit to two marks saves
        {' '}{(starterGz - twoMarksGz).toFixed(1)} kB — because an extension costs about
        {' '}{perExtension} kB and the engine underneath is {engineGz.toFixed(1)} kB. Tiptap splitting
        into a package per extension gets their minimum to
        {' '}{sizes.tiptap.minimum} kB, which is still {tiptapRatio}× Matra carrying everything,
        because ProseMirror is underneath it and is not optional.
      </p>
    </div>
  </section>

  <!-- Every extension, with the line you would write and the keys it answers to. -->
  <section class="section" id="directory">
    <div class="wrap">
      <p class="kicker">The whole directory</p>
      <h2>{directoryCount} extensions,<br />every one of them here.</h2>
      <p class="lede">
        The command, the shortcut, and the line you would actually write. Copy an import and it
        works — there is nothing else to install.
      </p>
    </div>
  </section>

  {
    directory.map((group) => (
      <section class="section">
        <div class="wrap">
          <div class="dir-head">
            <h3>{group.group}</h3>
            <span class="dir-pkg mono">{group.pkg}</span>
            <p>{group.note}</p>
          </div>

          <div class="dir fills bleed" data-static>
            {group.items.map((item) => (
              <div class="dir-row">
                <div class="dir-what">
                  <b class="mono">{item.name}</b>
                  <span>{item.what}</span>
                </div>
                <code class="dir-use mono">{item.use}</code>
                <div class="dir-keys">
                  {item.key && <span class="dir-key mono">{item.key}</span>}
                  {item.typed && <span class="dir-key typed mono">{item.typed}</span>}
                </div>
                <button
                  type="button"
                  class="dir-copy mono"
                  data-copy={importLine(item.name, group.pkg)}
                  aria-label={`Copy the import for ${item.name}`}
                >
                  <Icon icon={Copy01Icon} class="at-idle" size={13} />
                  <Icon icon={Tick02Icon} class="at-done" size={13} />
                  <span class="at-idle">import</span>
                  <span class="at-done">copied</span>
                </button>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

