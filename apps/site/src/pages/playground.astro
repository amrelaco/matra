---
import Footer from '../components/Footer.astro'
import Head from '../components/Head.astro'
import Icon from '../components/Icon.astro'
import Nav from '../components/Nav.astro'
import { FALLBACK, ICONS } from '../data/extension-icons'
import { TOOLS } from '../data/playground-tools'
import catalogue from '../data/playground.json'
import Base from '../layouts/Base.astro'

/**
 * The page where the central claim stops being a claim.
 *
 * Everywhere else the site says the extension array is the feature list. Here
 * you hold the array: tick a box and the editor is destroyed and rebuilt from
 * what is ticked, with the extension count, the measured kilobytes and the
 * milliseconds it took all moving with it.
 *
 * The document comes first and the picker second, because a ticked extension
 * you cannot reach proves nothing. `bold` does nothing visible unless you
 * already know Mod-B and `table` has no keystroke at all, so the toolbar
 * carries a button for every command the current editor has — and only those.
 */
const total = catalogue.groups.reduce((n, group) => n + group.items.length, 0)

/** Something with enough shape in it that every extension has work to do. */
const SEED = `<h2>A document, not a demo</h2>
<p>Everything here is a real Matra document. Select a few words and use the toolbar, or type <code>/</code> if you have ticked the slash menu.</p>
<ul><li><p>Tick an extension and this editor is rebuilt around it</p></li><li><p>Untick it and the button goes with it</p></li></ul>
<blockquote><p>The array is the feature list. Press Enter twice here to leave the quote.</p></blockquote>
<p>The numbers above are measured, not quoted.</p>`
---

<Base
  title="Playground | Matra"
  description={`Build a rich text editor by ticking extensions. ${total} of them, each with its measured gzipped cost, assembling a real editor you can type in.`}
>
  <Nav />
  <Head
    kicker="Playground"
    title="Tick what you<br />need. Type in it."
    lede="Every box rebuilds a real editor on this page · not a video, not a screenshot. The size is measured, and so is the time it took to build."
  />

  <section class="section flush">
    <div class="wrap">
      <div class="pg-readout">
        <div class="pg-stat">
          <span class="mono pg-figure" id="pg-count">0</span>
          <span class="pg-label">extensions</span>
        </div>
        <div class="pg-stat">
          <span class="mono pg-figure" id="pg-size">{catalogue.floorGz.toFixed(1)}</span>
          <span class="pg-label">kB gzipped</span>
        </div>
        <div class="pg-stat">
          <span class="mono pg-figure" id="pg-time">—</span>
          <span class="pg-label">ms to build</span>
        </div>
      </div>

      <div class="pg-paper">
        <div class="pg-toolbar" id="pg-toolbar" role="toolbar" aria-label="Editor commands">
          {
            TOOLS.map((tool) => (
              <button
                type="button"
                class="pg-tool"
                title={tool.title}
                aria-label={tool.title}
                data-cmd={tool.cmd}
                data-ext={tool.ext}
                data-args={tool.args.join(',')}
                hidden
              >
                <Icon icon={ICONS[tool.ext] ?? FALLBACK} size={16} />
              </button>
            ))
          }
          <p class="pg-toolbar-empty" id="pg-toolbar-empty">
            Nothing ticked. The editor below still runs · it just cannot do anything yet.
          </p>
        </div>

        <style id="pg-sheet" is:inline></style>
        <div id="pg-editor" class="pg-editor" set:html={SEED} />
        <p class="pg-error" id="pg-status" hidden></p>
        <p class="pg-error" id="pg-failed" hidden></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap pg-build">
      <div class="pg-picker">
        <h2 class="pg-h">What is in this editor</h2>
        <p class="pg-hint">
          Matra ships no features by default · an editor has exactly the extensions you hand it,
          and nothing else. These are all {total} of them, with what each one costs in gzipped kilobytes.
          Tick one and it is added to the document above; untick it and both the button and the behaviour
          go. Anything a ticked extension cannot work without is brought along and drawn outlined
          rather than filled.
        </p>
        <div class="pg-presets">
          <button type="button" class="btn ghost" id="pg-starter">Starter set</button>
          <button type="button" class="btn ghost" id="pg-clear">Clear</button>
        </div>

        {
          catalogue.groups.map((group) => (
            <div class="pg-group">
              <h3>
                {group.group}
                <span class="mono pg-group-n">{group.items.length}</span>
              </h3>
              <div class="pg-grid">
                {group.items.map((item) => (
                  <label class="pg-chip" title={item.what}>
                    <input type="checkbox" data-ext={item.name} data-what={item.what} />
                    <Icon icon={ICONS[item.name] ?? FALLBACK} size={19} class="pg-icon" />
                    <span class="mono pg-name">{item.name}</span>
                    <span class="mono pg-gz">{item.gz.toFixed(2)}</span>
                  </label>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <aside class="pg-out">
        <div class="pg-code-head">
          <h2 class="pg-h">Your editor, as code</h2>
          <button type="button" class="btn ghost" id="pg-copy">Copy</button>
        </div>
        <p class="pg-hint">Paste this into a project and you get the editor above.</p>
        <pre class="pg-code"><code class="mono" id="pg-code" /></pre>
      </aside>
    </div>
  </section>

  <Footer />

  <script>
    import '../scripts/playground.ts'
  </script>

  <style>
    /* --- the numbers ------------------------------------------------------- */

    .pg-readout {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 26rem;
      margin-bottom: 1.25rem;
      background-color: var(--surface);
      background-image: var(--dash-h), var(--dash-h), var(--dash-v), var(--dash-v);
      background-size:
        100% 1px,
        100% 1px,
        1px 100%,
        1px 100%;
      background-position:
        0 0,
        0 100%,
        0 0,
        100% 0;
      background-repeat: no-repeat;
    }

    .pg-stat {
      padding: 0.7rem 0.9rem;
      background-image: var(--dash-v);
      background-size: 1px 100%;
      background-position: 100% 0;
      background-repeat: no-repeat;
    }

    .pg-stat:last-child {
      background-image: none;
    }

    .pg-figure {
      display: block;
      font-size: 1.4rem;
      line-height: 1.1;
      color: var(--ink-strong);
      font-variant-numeric: tabular-nums;
    }

    .pg-label {
      font-size: 0.74rem;
      color: var(--ink-soft);
    }

    #pg-size.ticked {
      animation: pg-tick 420ms ease-out;
    }

    @keyframes pg-tick {
      0% {
        color: var(--indigo);
      }
      100% {
        color: var(--ink-strong);
      }
    }

    /* --- the document ------------------------------------------------------ */

    /*
      A sheet, because that is what people are here to judge. The picker moved
      below it: an editor you cannot reach proves nothing, and the first thing
      on the page should be the thing you type into.
    */
    .pg-paper {
      background-color: var(--surface);
      background-image: var(--dash-h), var(--dash-h), var(--dash-v), var(--dash-v);
      background-size:
        100% 1px,
        100% 1px,
        1px 100%,
        1px 100%;
      background-position:
        0 0,
        0 100%,
        0 0,
        100% 0;
      background-repeat: no-repeat;
    }

    .pg-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 2px;
      padding: 0.5rem 0.6rem;
      min-height: 2.6rem;
      background-image: var(--dash-h);
      background-size: 100% 1px;
      background-position: 0 100%;
      background-repeat: no-repeat;
    }

    .pg-tool {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.85rem;
      height: 1.85rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--ink-soft);
      cursor: pointer;
    }

    /*
      `display` on the class beats the `display: none` the UA stylesheet gives
      [hidden], so without this every button stays on screen while claiming to
      be hidden — visible to the eye, absent from the accessibility tree.
    */
    .pg-tool[hidden] {
      display: none;
    }

    .pg-tool:hover {
      background-color: var(--code-chrome);
      color: var(--ink);
    }

    /* Lit when the thing the button does is already true of the selection. */
    .pg-tool[aria-pressed='true'] {
      background-color: var(--indigo-wash);
      color: var(--indigo);
    }

    .pg-tool:focus-visible {
      outline: 2px solid var(--indigo);
      outline-offset: -2px;
    }

    .pg-toolbar-empty {
      margin: 0;
      padding-left: 0.2rem;
      font-size: 0.82rem;
      color: var(--ink-faint);
    }

    .pg-editor {
      min-height: 22rem;
      padding: 2.2rem clamp(1.2rem, 5vw, 3.5rem);
      font-size: 1rem;
      line-height: 1.7;
    }

    /* The measure a document wants, not the width the page happens to have. */
    .pg-editor > :global(*) {
      max-width: 46rem;
      margin-inline: auto;
    }

    .pg-editor:focus {
      outline: none;
    }

    .pg-error {
      margin: 0;
      padding: 0.7rem 1.2rem;
      background-image: var(--dash-h);
      background-size: 100% 1px;
      background-position: 0 0;
      background-repeat: no-repeat;
      color: var(--blood);
      font-size: 0.85rem;
    }

    /* --- the picker, and the code beside it --------------------------------- */

    .pg-build {
      display: grid;
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }

    .pg-h {
      margin: 0 0 0.5rem;
      font-size: 1.05rem;
      font-weight: 500;
    }

    .pg-hint {
      margin: 0 0 1rem;
      max-width: 62ch;
      color: var(--ink-soft);
      font-size: 0.9rem;
      line-height: 1.65;
    }

    .pg-presets {
      display: flex;
      gap: 0.5rem;
      padding-bottom: 0.9rem;
      background-image: var(--dash-h);
      background-size: 100% 1px;
      background-position: 0 100%;
      background-repeat: no-repeat;
    }

    /* The code follows you down the list it describes. */
    .pg-out {
      position: sticky;
      top: 1.5rem;
    }

    .pg-group {
      margin-top: 1.75rem;
    }

    .pg-group h3 {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin: 0 0 0.6rem;
      font-size: 1rem;
      font-weight: 500;
      color: var(--ink-faint);
    }

    .pg-group-n {
      font-size: 0.7rem;
      color: var(--rule-firm);
    }

    .pg-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(7.6rem, 1fr));
      gap: 0.4rem;
    }

    /*
      A square rather than a row. Seventy-six rows is a list you read; the same
      seventy-six as glyphs is something you scan, and scanning is what picking
      an extension actually is. Drawn with the site's dash, not the browser's.
    */
    .pg-chip {
      --dash: 3px;
      --dash-gap: 2px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.28rem;
      padding: 0.6rem 0.55rem 0.5rem;
      border: 0;
      background-color: var(--surface);
      background-image: var(--dash-h), var(--dash-h), var(--dash-v), var(--dash-v);
      background-size:
        100% 1px,
        100% 1px,
        1px 100%,
        1px 100%;
      background-position:
        0 0,
        0 100%,
        0 0,
        100% 0;
      background-repeat: no-repeat;
      cursor: pointer;
      transition: background-color 120ms ease;
    }

    .pg-chip:hover {
      background-color: var(--code-chrome);
    }

    .pg-chip input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    /* Keyboard only. A ring that appears on every mouse click is noise. */
    .pg-chip:has(input:focus-visible) {
      outline: 2px solid var(--indigo);
      outline-offset: 1px;
    }

    .pg-icon {
      color: var(--ink-faint);
      flex: none;
    }

    .pg-name {
      font-size: 0.7rem;
      line-height: 1.25;
      color: var(--ink);
      /* camelCase offers no break point, so the longest names would otherwise
         run past the chip. Breaking anywhere is the lesser of the two. */
      overflow-wrap: anywhere;
    }

    .pg-gz {
      font-size: 0.66rem;
      color: var(--ink-faint);
      font-variant-numeric: tabular-nums;
    }

    /*
      On. The dash goes indigo by moving the colour the gradients read, so the
      edge keeps the same rhythm as every other edge on the site.
    */
    .pg-chip:has(input:checked) {
      --rule-strong: var(--indigo);
      background-color: var(--indigo-wash);
    }

    .pg-chip:has(input:checked) .pg-icon {
      color: var(--indigo);
    }

    .pg-chip:has(input:checked) .pg-name {
      color: var(--indigo-deep);
    }

    /* Required by the schema rather than chosen: edged, not filled. */
    .pg-chip.implied:has(input:checked) {
      --rule-strong: var(--indigo);
      background-color: transparent;
    }

    .pg-chip.implied:has(input:checked) .pg-icon,
    .pg-chip.implied:has(input:checked) .pg-name {
      color: var(--ink-soft);
    }

    /* --- the code ---------------------------------------------------------- */

    .pg-code-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }

    .pg-code {
      margin: 0.75rem 0 0;
      padding: 0.9rem 1rem;
      border: 0;
      background-color: var(--code-bg);
      background-image: var(--dash-h), var(--dash-h), var(--dash-v), var(--dash-v);
      background-size:
        100% 1px,
        100% 1px,
        1px 100%,
        1px 100%;
      background-position:
        0 0,
        0 100%,
        0 0,
        100% 0;
      background-repeat: no-repeat;
      overflow-x: auto;
      font-size: 0.78rem;
      line-height: 1.65;
      color: var(--code-fg);
      white-space: pre-wrap;
      word-break: break-word;
    }

    @media (max-width: 900px) {
      .pg-build {
        grid-template-columns: minmax(0, 1fr);
        gap: 2rem;
      }

      /* Sticky in one column parks the code over the list it describes. */
      .pg-out {
        position: static;
      }

      .pg-grid {
        grid-template-columns: repeat(auto-fill, minmax(6.6rem, 1fr));
      }

      .pg-editor {
        min-height: 16rem;
        padding: 1.4rem 1.1rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #pg-size.ticked {
        animation: none;
      }
    }
  </style>
</Base>
