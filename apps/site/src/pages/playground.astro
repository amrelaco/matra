---
import { PlusSignIcon } from '@hugeicons/core-free-icons'
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'
import Nav from '../components/Nav.astro'
import ToolStrip from '../components/editor/ToolStrip.astro'
import CodeDrawer from '../components/playground/CodeDrawer.astro'
import ModeSwitch from '../components/playground/ModeSwitch.astro'
import Picker from '../components/playground/Picker.astro'
import Rail from '../components/playground/Rail.astro'
import { BLOCK_TOOLS, BUBBLE_TOOLS, TOOLS } from '../data/editor-tools'
import catalogue from '../data/playground.json'
import Base from '../layouts/Base.astro'
import { DEFAULT_SELECTION, FLOOR, withRequirements } from '../scripts/playground/state'
import '../styles/playground.css'

/**
 * The page where the central claim stops being a claim.
 *
 * Everywhere else the site says the extension array is the feature list. Here
 * you hold the array: tick a box and the editor is destroyed and rebuilt from
 * what is ticked, with the extension count, the measured kilobytes and the
 * milliseconds it took all moving with it.
 *
 * Three things were added once ticking alone stopped being enough:
 *
 *   - every extension carries a demo, because a ticked box proves the array
 *     changed and nothing else. The margin says what to do and offers to do it;
 *   - the menus are real. `bubbleMenu`, `floatingMenu` and the slash menu used
 *     to be mounted into a hidden div, which is a working extension nobody can
 *     see. They now have interfaces, and this page is where they live;
 *   - four skins, because "Matra draws nothing" is a sentence until the same
 *     document is sitting under a Notion-shaped interface and a Docs-shaped one
 *     with the array barely moving underneath.
 */
const total = catalogue.groups.reduce((n, group) => n + group.items.length, 0)

/**
 * What the bar looks like before a line of script has run.
 *
 * Worked out from the same starter set the script falls back to, so a first
 * visit renders the toolbar it is about to have and nothing moves. The module
 * is safe to import here: it touches `window` inside its functions and never at
 * the top level.
 */
const opensWith = new Set([...FLOOR, ...withRequirements(DEFAULT_SELECTION)])

/** Something with enough shape in it that every extension has work to do. */
const SEED = `<h2>A document, not a demo</h2>
<p>Everything on this page is <span data-comment="thread-welcome">a real Matra document</span>. Select a few words for the bubble menu, or type <code>/</code> on an empty line once the slash menu is ticked.</p>
<ul><li><p>Tick an extension and this editor is rebuilt around it</p></li><li><p>Untick it and the button goes with it</p></li></ul>
<blockquote><p>The array is the feature list. Press Enter twice here to leave the quote.</p></blockquote>
<p>The numbers above are measured, not quoted.</p>`
---

<Base
  title="Playground | Matra"
  description={`Build a rich text editor by ticking extensions. ${total} of them, each with its measured gzipped cost, assembling a real editor you can type in — with a slash menu, a bubble menu and comment threads you can actually use.`}
>
  <Nav />
  <!--
    A workbench, not a page. Pick on the left, watch in the middle, read the
    margin on the right — three panes that scroll on their own inside one
    screen-height frame, because ticking something at the foot of the list must
    not mean scrolling back up to see what it did.
  -->
  <section class="pg-bench" id="pg-bench" data-mode="paper">
    <Picker />

    <div class="pg-main">
      <!--
        data-static on everything that is instrumentation rather than prose.

        The site-wide sweep turns every heading and paragraph into an editor,
        which is the point of the site and wrong for a control: it found the
        readout's figures, the toolbar's "nothing ticked" line and the margin's
        panel headings, mounted editors over them, and left this page rewriting
        the contents of editor instances on every keystroke. The picker's own
        prose is left editable, because that part *is* prose.
      -->
      <!--
        The workbench's controls, in one place.

        The title, the standfirst and the three presets used to live at the top
        of the catalogue column, where they cost a third of it before a single
        extension appeared and had nothing to do with the list underneath. The
        left column is a filter and a grid now; everything you press to change
        the *workbench* is here, and everything that reports on it is beside it.
      -->
      <!--
        The workbench's controls, in one place and in four quadrants.

        The title, the standfirst and the three presets used to live at the top
        of the catalogue column, where they cost a third of it before a single
        extension appeared and had nothing to do with the list underneath. Then
        they arrived here all stacked in the top right corner, which was worse:
        three unrelated groups of controls in one pile.

        Two rows, each a left and a right: what this is, and what it costs; what
        you can preset, and what it can look like. Nothing shares a corner with
        something it is unrelated to.
      -->
      <header class="pg-head" data-static>
        <div class="pg-head-row">
          <div class="pg-head-lede">
            <p class="kicker">Playground</p>
            <h1 class="pg-h">Tick what you need</h1>
          </div>

          <div class="pg-readout">
            <div class="pg-stat">
              <span class="mono pg-figure" id="pg-count">0</span>
              <span class="pg-label">extensions</span>
            </div>
            <div class="pg-stat">
              <span class="mono pg-figure" id="pg-size">{catalogue.floorGz.toFixed(1)}</span>
              <span class="pg-label">kB gzipped</span>
            </div>
            <div class="pg-stat">
              <span class="mono pg-figure" id="pg-time">—</span>
              <span class="pg-label">ms to build</span>
            </div>
          </div>
        </div>

        <!--
          Two choices, and both of them say so.

          Three bare buttons beside four bare words told a first-time visitor
          nothing: not what they change, not that they are two unrelated
          things, not that each is a pick-one. A word in front of each, and the
          same segmented shape for both, is the whole fix.
        -->
        <div class="pg-head-row">
          <div class="pg-head-group">
            <span class="pg-head-label">Preset</span>
            <div class="pg-seg pg-presets">
              <button
                type="button"
                class="pg-seg-btn"
                id="pg-starter"
                data-tip="Enough to type into · bold, italic, links, headings and lists"
                >Starter</button
              >
              <button
                type="button"
                class="pg-seg-btn"
                id="pg-everything"
                data-tip="Tick all 76 and load a document that uses every one of them"
                >Everything</button
              >
              <button
                type="button"
                class="pg-seg-btn"
                id="pg-clear"
                data-tip="Untick everything · the editor still runs, it just cannot do anything"
                >None</button
              >
            </div>
          </div>

          <div class="pg-head-group">
            <span class="pg-head-label">Interface</span>
            <ModeSwitch />
          </div>
        </div>
      </header>

      <ToolStrip
        id="pg-bar"
        tools={TOOLS}
        look="glyphs"
        grouped
        label="Editor commands"
        visible={opensWith}
        static
      >
        <!--
          Hidden until the script has looked. It is only true when the editor
          genuinely has no commands, and a message that starts visible is one
          that shows whenever the script has not run yet.
        -->
        <p class="pg-toolbar-empty" id="pg-toolbar-empty" hidden>
          Nothing ticked · the editor runs, it just cannot do anything yet.
        </p>
      </ToolStrip>

      <!--
        Two small pieces of interface that used to be browser modals.

        `window.prompt` for a link address and `window.alert` for "select
        something first" both block the page, cannot be styled, and take the
        selection away from the editor they are about — which for the link
        prompt meant the command ran against nothing when you pressed OK.
      -->
      <p class="pg-note" id="pg-note" hidden></p>

      <style id="pg-sheet" is:inline></style>

      <div class="pg-stage">
        <div class="pg-scroll" id="pg-scroll">
          <div class="pg-canvas">
            <div class="pg-page">
              <!--
                data-static keeps the site-wide editable sweep off this element.
                It skips .matra-editor, but that class only lands once Matra has
                mounted — so without this the sweep finds the seed's h2 first and
                mounts its own editor over it.
              -->
              <div id="pg-editor" class="pg-editor" data-static set:html={SEED} />
            </div>
            <div class="pg-margin" id="pg-margin" data-count="0" data-static></div>
          </div>

          <ToolStrip
            id="pg-bubble"
            class="mx-bubble"
            tools={BUBBLE_TOOLS}
            look="glyphs"
            label="Format the selection"
            hidden
          />
          <!--
            A plus, not a bar.

            `floatingMenu` shows its element whenever the caret is on an empty
            top-level line, which with twelve buttons in it meant a dark strip
            sitting in the document at all times — it was on screen before
            anybody asked for anything. One button is an offer; twelve is
            furniture. Pressing it opens the strip below.
          -->
          <div class="mx-plus" id="pg-floating" hidden>
            <button
              type="button"
              id="pg-plus"
              data-tip="Insert a block"
              aria-label="Insert a block"
            >
              <Icon icon={PlusSignIcon} size={14} />
            </button>
          </div>

          <ToolStrip
            id="pg-blocks"
            class="mx-floating"
            tools={BLOCK_TOOLS}
            look="glyphs"
            label="Insert a block"
            hidden
          />

          <!--
            The block palette. Ten hues in two rows: the first sets the text
            colour of the block, the second its background. Notion's shape,
            this site's colours — the swatch carries its own value in
            `data-color`, so the script needs no table of its own.
          -->
          <div class="pg-palette" id="pg-palette" hidden>
            <div class="pg-palette-row">
              <span class="pg-palette-label">Text</span>
              <div class="pg-palette-swatches" id="pg-palette-text"></div>
            </div>
            <div class="pg-palette-row">
              <span class="pg-palette-label">Background</span>
              <div class="pg-palette-swatches" id="pg-palette-bg"></div>
            </div>
            <button type="button" class="btn ghost small" id="pg-palette-clear">
              Clear colour
            </button>
          </div>

          <div class="mx-linkbar" id="pg-linkbar" hidden>
            <input
              type="url"
              id="pg-linkbar-input"
              placeholder="https://"
              aria-label="Link address"
            />
            <button type="button" class="btn small" id="pg-linkbar-ok">Link</button>
            <button type="button" class="btn ghost small" id="pg-linkbar-cancel">Cancel</button>
          </div>
        </div>

        <Rail />
      </div>

      <p class="pg-error" id="pg-status" hidden></p>
      <p class="pg-error" id="pg-failed" hidden></p>

      <CodeDrawer />
    </div>
  </section>

  <Footer />

  <script>
    import '../scripts/playground/index'
  </script>
</Base>
