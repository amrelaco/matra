---
import { GithubIcon, Moon02Icon, Sun03Icon } from '@hugeicons/core-free-icons'
import Icon from './Icon.astro'
import Logo from './Logo.astro'
const links = [
  ['Docs', '/docs'],
  ['Extensions', '/extensions'],
  ['Playground', '/playground'],
  ['Benchmarks', '/#speed'],
  ['Pricing', '/pricing'],
]

/**
 * Which link describes where you are.
 *
 * Compared without the trailing slash, because Astro builds directory-style
 * URLs and `/docs/` would otherwise never match `/docs`. Docs is a section:
 * every page under it lights the one entry, which is what a reader deep in
 * `/docs/position-mapping` needs to see.
 *
 * A link carrying a hash is never current. `/#speed` is a place on the home
 * page rather than a page of its own, and treating its path as a match lit
 * Benchmarks on the home page — where the reader has not gone anywhere yet.
 */
const here = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isCurrent = (href: string): boolean => {
  if (href.includes('#')) return false
  const target = href.replace(/\/+$/, '') || '/'
  return here === target || here.startsWith(`${target}/`)
}
---

<nav>
  <div class="bar">
    <a href="/" class="brand" aria-label="Matra, home">
      <Logo size={20} />
      <span>Matra</span>
    </a>

    <div class="links">
      {
        links.map(([label, href]) => {
          const current = isCurrent(href as string)
          return (
            <a
              href={href}
              class={current ? 'current' : undefined}
              aria-current={current ? 'page' : undefined}
            >
              {label}
            </a>
          )
        })
      }
    </div>

    <div class="right">
      <a class="gh" href="https://github.com/amrelaco/matra">
        <Icon icon={GithubIcon} size={15} />
        <span>GitHub</span>
      </a>
      <!--
        Both glyphs are rendered and CSS shows one, so the button is correct in
        the markup the server sent. Swapping it in JavaScript would mean a sun
        briefly showing on a dark page on every single load.

        Drawn as a peer of the GitHub link beside it rather than as a bordered
        square: two items in a row, one boxed and one not, reads as a stray box
        rather than as a pair.
      -->
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="Use the dark theme"
        aria-pressed="false"
      >
        <Icon icon={Moon02Icon} class="at-light" size={15} />
        <Icon icon={Sun03Icon} class="at-dark" size={15} />
        <span class="at-light">Dark</span>
        <span class="at-dark">Light</span>
      </button>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 40;
    /* background-color, never the shorthand: `background` resets
       background-image, and the rule under the bar is a background image. It
       took the dashed line off the whole nav and left no trace of doing it. */
    background-color: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    background-image: var(--dash-h);
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
  }
  .bar {
    max-width: var(--page);
    margin: 0 auto;
    padding: 16px calc(var(--gutter) + var(--inset));
    display: flex;
    align-items: center;
    gap: var(--s4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-display);
    font-size: 21px;
    text-decoration: none;
    flex: none;
  }
  .links {
    display: flex;
    gap: var(--s3);
    font-size: 14.5px;
    margin-right: auto;
  }
  .links a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  .links a:hover {
    color: var(--ink);
  }
  /*
    The current section, said with weight and colour alone. A rule under it
    added a third horizontal line to a bar that already has two.
  */
  .links a.current {
    color: var(--ink-strong);
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--s2);
    flex: none;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14.5px;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .gh:hover {
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .bar {
      gap: var(--s2);
    }
    .links {
      display: none;
    }
  }
</style>
