---
import Logo from './Logo.astro'
const links = [
  ['Docs', '/docs'],
  ['Extensions', '/extensions'],
  ['Benchmarks', '/#speed'],
  ['Pricing', '/pricing'],
]
---
<nav>
  <div class="bar">
    <a href="/" class="brand" aria-label="Matra, home">
      <Logo size={20} />
      <span>Matra</span>
    </a>

    <div class="links">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </div>

    <div class="right">
      <a class="gh" href="https://github.com/amrelaco/matra">GitHub</a>
    </div>
  </div>
</nav>

<style>
  nav {
    border-bottom: 1px dashed var(--rule-strong);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    z-index: 40;
  }
  .bar {
    max-width: var(--page);
    margin: 0 auto;
    padding: 16px var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--s4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-display);
    font-size: 21px;
    text-decoration: none;
    flex: none;
  }
  .links { display: flex; gap: var(--s3); font-size: 14.5px; margin-right: auto; }
  .links a { text-decoration: none; color: var(--ink-soft); }
  .links a:hover { color: var(--ink); }
  .right { display: flex; align-items: center; gap: var(--s2); flex: none; }
  .gh { font-size: 14.5px; text-decoration: none; color: var(--ink-soft); }
  .gh:hover { color: var(--ink); }

  @media (max-width: 860px) {
    .bar { gap: var(--s2); }
    .links { display: none; }
  }
</style>
