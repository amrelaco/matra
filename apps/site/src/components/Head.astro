---
interface Props {
  kicker: string
  title: string
  lede?: string
}
const { kicker, title, lede } = Astro.props
---
<header class="section" style="border-top: none">
  <div class="wrap head">
    <p class="kicker"><span class="dot"></span>{kicker}</p>
    <h1 set:html={title} />
    {lede && <p class="lede">{lede}</p>}
  </div>
</header>
<style>
  .dot { width: 5px; height: 5px; background: var(--indigo); display: inline-block; }
  .head { padding-top: 72px; padding-bottom: 40px; }
  .head h1 { font-size: clamp(36px, 4.4vw, 56px); margin: 16px 0 18px; }
</style>
