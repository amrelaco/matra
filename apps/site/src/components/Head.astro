---
interface Props {
  kicker: string
  title: string
  lede?: string
}
const { kicker, title, lede } = Astro.props
---
<header class="page-head">
  <div class="wrap">
    <p class="kicker">{kicker}</p>
    <div data-editable="typography" data-hint="typography extension">
      <h1 set:html={title} />
    </div>
    {lede && (
      <div data-editable="typography" data-hint="try typing here">
        <p class="lede">{lede}</p>
      </div>
    )}
  </div>
</header>
