---
import Logo from './Logo.astro'
const columns = [
  [
    'Product',
    [
      ['Documentation', '/docs'],
      ['Extensions', '/extensions'],
      ['Pricing', '/pricing'],
      ['Benchmarks', '/#speed'],
    ],
  ],
  [
    'Project',
    [
      ['GitHub', 'https://github.com/amrelaco/matra'],
      ['npm', 'https://www.npmjs.com/package/@matrajs/core'],
      ['Licence', '/licence'],
    ],
  ],
  [
    'Company',
    [
      ['Amrela', 'https://amrela.co'],
      ['Contact', '/contact'],
      ['Privacy', '/privacy'],
      ['Terms', '/terms'],
    ],
  ],
] as const
---
<footer class="section site-footer">
  <div class="wrap foot">
    <div class="brand-col">
      <div class="brand"><Logo size={18} /> <span>Matra</span></div>
      <p>A headless rich text editor framework.<br />Built by Amrela in Dhaka.</p>
    </div>
    <div class="cols">
      {columns.map(([heading, links]) => (
        <div>
          <h4 class="mono">{heading}</h4>
          {links.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      ))}
    </div>
  </div>
  <div class="bottom-wrap">
    <div class="bottom mono">
      <span>© 2026 Amrela</span>
      <span>Dhaka, Bangladesh</span>
    </div>
  </div>
</footer>
