---
const columns = [
  [
    'Product',
    [
      ['Documentation', '/docs'],
      ['Extensions', '/extensions'],
      ['Pricing', '/pricing'],
      ['Benchmarks', '/#speed'],
    ],
  ],
  [
    'Project',
    [
      ['GitHub', 'https://github.com/amrelaco/matra'],
      ['npm', 'https://www.npmjs.com/package/@matrajs/core'],
      ['MIT licence', '/licence'],
    ],
  ],
  [
    'Company',
    [
      ['Amrela', 'https://amrela.co'],
      ['Privacy', '/privacy'],
      ['Terms', '/terms'],
    ],
  ],
] as const
---
<footer class="section">
  <div class="wrap foot">
    <div>
      <div class="brand-line"><span class="mark"></span> Matra</div>
      <p class="foot-note">
        A headless rich text editor framework.<br />Built by Amrela in Dhaka.
      </p>
    </div>
    <div class="foot-cols">
      {columns.map(([heading, links]) => (
        <div>
          <h4 class="mono">{heading}</h4>
          {links.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      ))}
    </div>
  </div>
  <div class="wrap bottom mono">
    <span>© 2026 Amrela</span><span>Dhaka, Bangladesh</span>
  </div>
</footer>

<style>
  .foot { display: flex; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .brand-line { display: flex; align-items: center; gap: 9px; font-family: var(--font-display); font-size: 19px; }
  .brand-line .mark { width: 14px; height: 14px; background: var(--indigo); }
  .foot-note { color: var(--ink-faint); font-size: 13px; margin-top: 10px; }
  .foot-cols { display: flex; gap: 56px; }
  .foot-cols h4 { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); font-weight: 400; margin: 0 0 12px; }
  .foot-cols a { display: block; font-size: 13.5px; color: var(--ink-soft); text-decoration: none; padding: 3px 0; }
  .foot-cols a:hover { color: var(--ink); }
  .bottom { display: flex; justify-content: space-between; padding-bottom: 28px; font-size: 11px; color: var(--ink-faint); border-top: 1px dashed var(--rule); padding-top: 18px; }
  @media (max-width: 560px) { .foot-cols { gap: 30px; flex-wrap: wrap; } }
</style>
