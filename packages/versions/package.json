{
  "name": "@matrajs/versions",
  "version": "0.16.0",
  "description": "Version history for Matra \u2014 snapshots, a real diff between them, and restore as one undo step.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Nahim Hossain Shohan",
  "homepage": "https://matrajs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrelaco/matra.git",
    "directory": "packages/versions"
  },
  "bugs": {
    "url": "https://github.com/amrelaco/matra/issues"
  },
  "keywords": ["editor", "rich-text", "history", "versions", "diff", "matra"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@matrajs/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
