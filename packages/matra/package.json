{
  "name": "matra",
  "version": "0.0.1",
  "description": "Matra — a headless rich text editor framework with a first-class extension API. Batteries-included entry point.",
  "license": "MIT",
  "author": "Nahim Hossain Shohan",
  "homepage": "https://matrajs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrelaco/matra.git",
    "directory": "packages/matra"
  },
  "bugs": { "url": "https://github.com/amrelaco/matra/issues" },
  "keywords": ["editor", "rich-text", "prosemirror", "wysiwyg", "matra", "extensions"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@matra/core": "workspace:*"
  }
}
