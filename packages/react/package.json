{
  "name": "@matrajs/react",
  "version": "1.0.1",
  "description": "React bindings for Matra \u2014 useEditor, useEditorState, useEditorFocus and EditorContent.",
  "license": "MIT",
  "author": "Nahim Hossain Shohan",
  "homepage": "https://matrajs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrelaco/matra.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/amrelaco/matra/issues"
  },
  "keywords": ["editor", "rich-text", "react", "matra", "prosemirror"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@matrajs/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
