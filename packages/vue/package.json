{
  "name": "@matrajs/vue",
  "version": "0.7.0",
  "description": "Vue 3 bindings for Matra \u2014 useEditor and EditorContent.",
  "license": "MIT",
  "author": "Nahim Hossain Shohan",
  "homepage": "https://matrajs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrelaco/matra.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/amrelaco/matra/issues"
  },
  "keywords": ["editor", "rich-text", "vue", "matra"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@matrajs/core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "vue": "^3.5.41"
  }
}
