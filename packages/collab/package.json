{
  "name": "@matrajs/collab",
  "version": "0.10.0",
  "description": "Collaborative editing for Matra \u2014 step exchange, rebasing and presence. No CRDT dependency.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Nahim Hossain Shohan",
  "homepage": "https://matrajs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amrelaco/matra.git",
    "directory": "packages/collab"
  },
  "bugs": {
    "url": "https://github.com/amrelaco/matra/issues"
  },
  "keywords": ["editor", "rich-text", "collaborative", "matra", "ot"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@matrajs/core": "workspace:^"
  }
}
