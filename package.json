{
  "name": "matra-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter playground dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check .",
    "fix": "biome check --write .",
    "stamp": "node scripts/stamp.mjs",
    "size": "node scripts/size.mjs",
    "links": "node scripts/links.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vue/test-utils": "^2.4.6",
    "esbuild": "^0.28.2",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}
